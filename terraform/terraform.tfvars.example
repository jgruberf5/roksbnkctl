# ============================================================
# terraform.tfvars.example
# F5 BIG-IP Next for Kubernetes 2.3 — Direct Terraform Project
#
# Copy this file to terraform.tfvars and fill in your values.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # edit terraform.tfvars
#   terraform init
#   terraform plan
#   terraform apply
#   terraform destroy
#
# To use a specific branch of a sub-repo, edit the `source`
# argument in main.tf (e.g. change ?ref=main to ?ref=my-branch).
# Module sources cannot be parameterised — they must be literals.
#
# Required (no default):
#   ibmcloud_api_key
#
# ------------------------------------------------------------
# Using roksbnkctl? You normally do NOT hand-author these names.
#
# Since v1.8.0, roksbnkctl generates every account-scoped
# resource name from a single workspace PREFIX collected at
# `roksbnkctl init`:
#
#   openshift_cluster_name               = <prefix>
#   roks_cluster_vpc_name                = <prefix>-cluster-vpc
#   roks_cos_instance_name               = <prefix>-registry-cos
#   roks_transit_gateway_name            = <prefix>-tgw
#   testing_client_vpc_name              = <prefix>-client-vpc
#   testing_tgw_jumphost_name            = <prefix>-jh-tgw
#   testing_cluster_jumphost_name_prefix = <prefix>-jh   (module
#                                          appends -<zone>)
#
# This file is the OVERRIDE REFERENCE: copy it (or any subset)
# to ~/.roksbnkctl/<workspace>/terraform.tfvars.user (or pass it
# via --var-file) and roksbnkctl layers it LAST, so any value
# here overrides the prefix-generated name. The per-variable
# examples below are kept intact for exactly that purpose.
#
# Running terraform directly (no roksbnkctl)? The defaults below
# are static `tf-*` placeholders and WILL collide across stacks
# in the same IBM Cloud account — set unique names per stack.
# ------------------------------------------------------------
# ============================================================


# ============================================================
# IBM Cloud — Common
# ============================================================

# IBM Cloud API key for all operations.
ibmcloud_api_key = "YOUR_IBMCLOUD_API_KEY"

# IBM Cloud region where the ROKS cluster and VPC resources are created.
ibmcloud_cluster_region = "ca-tor"

# Resource group for all resources.
ibmcloud_resource_group = "default"


# ============================================================
# ROKS Cluster (ws1)
# ============================================================

# Set to false to skip cluster creation and supply an existing cluster below.
create_roks_cluster = true

# Required when create_roks_cluster = false.
roks_cluster_id_or_name = ""

# Set to false to skip Transit Gateway creation.
create_roks_transit_gateway = true

# Set to false to skip COS instance creation for the OpenShift image registry.
create_roks_registry_cos_instance = true

# Name of the cluster VPC.
roks_cluster_vpc_name = "tf-cluster-vpc"

# Name of the OpenShift cluster.
openshift_cluster_name = "tf-openshift-cluster"

# OpenShift version. Leave empty to use the latest available.
openshift_cluster_version = "4.18"

# Worker nodes per availability zone.
roks_workers_per_zone = 1

# Minimum vCPU count for auto-selecting the worker node flavor.
roks_min_worker_vcpu_count = 16

# Minimum memory (GB) for auto-selecting the worker node flavor.
roks_min_worker_memory_gb = 64

# Name of the COS instance for the OpenShift image registry.
roks_cos_instance_name = "tf-openshift-cos-instance"

# Name of the Transit Gateway.
roks_transit_gateway_name = "tf-tgw"


# ============================================================
# cert-manager (ws2)
# ============================================================

# Set to false to skip cert-manager installation.
# cert_manager_namespace is still passed to ws3 (FLO) when false.
install_cert_manager = true

# Kubernetes namespace for cert-manager.
cert_manager_namespace = "cert-manager"

# cert-manager Helm chart version.
cert_manager_version = "v1.17.3"


# ============================================================
# COS Bucket — shared by FLO (ws3) and License (ws5)
# ============================================================

# Region of the COS bucket containing FAR credentials and JWT files.
ibmcloud_cos_bucket_region = "us-south"

# Name of the COS instance holding the FAR auth key and JWT.
ibmcloud_cos_instance_name = "bnk-orchestration"

# Name of the COS bucket holding the FAR auth key and JWT files.
ibmcloud_resources_cos_bucket = "bnk-schematics-resources"


# ============================================================
# BIG-IP Next for Kubernetes — FLO / CNEInstance / License (ws3–ws5)
# ============================================================

# Set to false to skip FLO (ws3), CNEInstance (ws4), and License (ws5).
deploy_bnk = true

# --- FLO (ws3) ---

# FAR repository URL for Docker and Helm images.
far_repo_url = "repo.f5.com"

# Air-gap registry mirror (PRD 11). When you mirror FAR into an in-cluster
# registry, split the chart-pull host from the image-pull host (each falls
# back to far_repo_url when empty), and flip use_registry_mirror to pull via
# in-cluster RBAC (drops the FAR dockerconfigjson secret). Leave as-is for a
# direct-from-FAR install.
# far_chart_repo_url  = ""      # chart-pull host (helm_release + manifest pull)
# far_image_repo_url  = ""      # image-pull host (image.repository + CNEInstance registry)
# use_registry_mirror = false   # true → pull from the in-cluster mirror by RBAC

# Version of the f5-bigip-k8s-manifest chart.
f5_bigip_k8s_manifest_version = "2.3.0-3.2598.3-0.0.170"

# Filename of the FAR auth key archive in the COS bucket.
f5_cne_far_auth_file = "f5-far-auth-key.tgz"

# Filename of the subscription JWT in the COS bucket.
f5_cne_subscription_jwt_file = "trial.jwt"

# Kubernetes namespace for the F5 Lifecycle Operator.
flo_namespace = "f5-bnk"

# Kubernetes namespace for F5 utility components.
flo_utils_namespace = "f5-utils"

# BIG-IP credentials for the CIS controller (leave blank if not using CIS).
bigip_username = "admin"
bigip_password = "admin"
bigip_url      = "https://192.168.1.245"


# --- FLO output overrides (ws3 → ws4) ---
#
# Terraform wires these automatically from ws3 module outputs.
# Override here only if ws3 was applied outside this Terraform state
# and you need to supply the values manually.

# flo_trusted_profile_id  = ""
# flo_cluster_issuer_name = ""
# cneinstance_network_attachments = ["ens3-ipvlan-l2", "macvlan-conf"]


# --- CNEInstance (ws4) ---

# Deployment size for the CNEInstance.  Options: Tiny, Small, Medium, Large.
cneinstance_deployment_size = "Small"

# GSLB datacenter name. Leave empty if not using GSLB.
cneinstance_gslb_datacenter_name = ""

# Per-zone TMM data-plane networking — one object per availability zone.
# IMPORTANT for a hand-run terraform apply: this programs the
# cloud-network-mapping ConfigMap and the external/internal F5SPKVlan
# self-IP CRs. Leave it empty and TMM's RoutingDone readiness gate never
# flips. (roksbnkctl deploys render this from the config.yaml
# `bnk.network.zones` block; a raw terraform apply must set it here.)
# Values come from your cluster's data-plane VLAN subnets / the BNK install
# guide network table. ext_vlan_cidr is also the source of the gateway
# static-route next-hop (see the Gateway phase section below).
# cneinstance_network_zones = [
#   { ext_vlan_cidr   = "10.10.1.0/24",  int_vlan_cidr   = "10.20.1.0/24",
#     int_snat_cidr   = "10.30.1.0/24",  int_vip_cidr    = "10.40.1.0/24",
#     external_selfip = "10.10.1.10",    internal_selfip = "10.20.1.10" },
#   # …repeat per AZ
# ]

# Self-IP prefix length TMM applies on the F5SPKVlan CRs (spec.prefixlen_v4) — the
# size of the L2 subnet TMM treats as directly connected. Match your VLAN CIDRs above.
# (roksbnkctl: config.yaml `bnk.network.vlan_prefixlen`.)
# cneinstance_vlan_prefixlen = 24

# Kubernetes pod CIDR TMM installs a route toward (advanced.tmm.env TMM_K8S_ROUTES)
# so it can reach backend pods. Default is the ROKS pod subnet; set to your cluster's
# actual pod CIDR if non-default. (roksbnkctl: config.yaml `bnk.network.tmm_k8s_routes`.)
# cneinstance_tmm_k8s_routes = "172.17.0.0/18"


# --- License (ws5) ---

# License mode. Options: connected, disconnected.
license_mode = "connected"


# ============================================================
# Testing Jumphosts (ws6)
# ============================================================

# Create a jumphost in a client VPC connected to the cluster via Transit Gateway.
testing_create_tgw_jumphost = true

# Create one jumphost per availability zone inside the cluster VPC.
testing_create_cluster_jumphosts = false

# Name of the IBM Cloud SSH key to inject into jumphosts.
# Must already exist in the target region.
testing_ssh_key_name = "my-ssh-key"

# Instance profile for jumphosts. Leave empty to auto-select.
testing_jumphost_profile = ""

# Minimum vCPU count for auto-selecting the jumphost profile.
testing_min_vcpu_count = 4

# Minimum memory (GB) for auto-selecting the jumphost profile.
testing_min_memory_gb = 8

# Set to true to create a new client VPC for the TGW jumphost.
# When false, testing_client_vpc_name must reference an existing VPC.
testing_create_client_vpc = false

# Name of the client VPC for the TGW jumphost.
testing_client_vpc_name = "tf-testing-vpc"

# Region for the client VPC and TGW jumphost.
testing_client_vpc_region = "ca-tor"

# Name of the TGW-connected jumphost instance.
testing_tgw_jumphost_name = "tf-testing-jumphost-tgw"

# Name prefix for cluster jumphosts. Zone is appended: <prefix>-<zone>.
testing_cluster_jumphost_name_prefix = "tf-testing-jumphost-cluster"


# ============================================================
# Gateway phase (data-plane ingress/egress config) — optional
# ============================================================
#
# The Gateway phase applies the Gateway API + SnatPool + Egress + static
# routes + the VXLAN security-group rule on top of a healthy BNK. With
# roksbnkctl it runs as `roksbnkctl gateway up` (deploy_gateway is forced
# on for that phase and off for all others — don't set it by hand).

# Application namespace the Gateway + HTTPRoute serve.
gateway_app_namespace = "f5-app"

# HTTPRoute backend service + port in that namespace.
gateway_backend_service = "nginx-service"
gateway_backend_port    = 80

# Egress SNAT strategy: snatpool | automap | both.
gateway_egress_mode = "snatpool"

# Egress VXLAN UDP port (also opened on the cluster security group).
gateway_vxlan_port = 6789

# Client subnets the TMM static routes reach (the test-traffic sources).
# LISTS of CIDRs — the module installs one F5SPKStaticRoute per entry × zone,
# so every client gets a TMM return route. "local" = cluster-VPC clients
# (one CIDR per cluster jumphost subnet, so a same-zone AND a different-zone
# jumphost are both reachable); "remote" = client-VPC clients over the TGW.
# Empty (the default) = no client routes.
#
# Two ways to fill them:
#
#   1. Let roksbnkctl fill them. `roksbnkctl gateway up` auto-derives both
#      lists from the deployed Testing-phase jumphost subnets when you leave
#      them unset (local = every cluster jumphost subnet, remote = the TGW
#      jumphost subnet), and logs what it chose. Just omit them here.
#
#   2. Discover them yourself, after `testing up` — the jumphost subnet CIDRs:
#        roksbnkctl --on jumphost -- ibmcloud is subnet <prefix>-jh-tgw-subnet \
#          --output json | jq -r .ipv4_cidr_block            # → one remote CIDR
#        roksbnkctl --on jumphost -- ibmcloud is subnet <prefix>-jh-<zone>-subnet \
#          --output json | jq -r .ipv4_cidr_block            # → one local CIDR per zone
#
# gateway_client_subnet_local  = ["10.244.1.0/24", "10.244.2.0/24"]
# gateway_client_subnet_remote = ["10.245.64.0/24"]


# ============================================================
# Managed by roksbnkctl — do NOT set by hand
# ============================================================
#
# These are written by roksbnkctl's per-phase overrides (cluster reuse,
# phase toggles, runner scratch paths). They're listed for reference only;
# setting them in this file fights the orchestration.
#
# deploy_gateway          = false   # forced on only by `gateway up`
# deploy_cert_manager     = true    # forced off in the BNK reuse phase
# use_existing_cluster_vpc = false  # forced true in the 2nd phase (cluster reuse)
# existing_cluster_vpc_id  = ""     # sourced from cluster-outputs.json
# kubeconfig_dir = "/work/.bnk/scratch/kubeconfig"  # runner-image mount
# scratch_dir    = "/work/.bnk/scratch"             # runner-image mount
