#cloud-config
# F5 License Proxy on a stock Ubuntu VSI (Case B: podman pod, no Kubernetes).
# Rendered by the flp_vsi terraform module. The CA is generated by terraform and
# injected here; the box generates the mTLS leaves from it and brings up the pod.
package_update: true
packages: [podman, openssl, jq, curl]

write_files:
  - path: /opt/flp/answer.env
    permissions: '0600'
    content: |
      JWT_TOKEN=${jwt_token}
      EXTERNAL_IP=${external_ip}
      REG=${reg}
      TAG=${tag}
      VAULT_TAG=${vault_tag}
      F5_CERT_URL=${f5_cert_url}
      F5_ENTITLEMENT_URL=${f5_entitlement_url}
      F5_INITIAL_CONFIG_URL=${f5_initial_config_url}
      MODE_OF_OPERATION=${mode_of_operation}
      IS_PROXY_ENABLED=${proxy_enabled}
      PROXY_HOST=${proxy_host}
      PROXY_PORT=${proxy_port}
      PROXY_PROTOCOL=${proxy_protocol}
  - path: /opt/flp/cne_pull_64.json
    permissions: '0600'
    content: |
      ${far_sa_b64}
  - path: /opt/flp/prod_jwks.txt
    permissions: '0644'
    encoding: b64
    content: ${prod_jwks_b64}
  - path: /opt/flp/ca.crt
    permissions: '0644'
    encoding: b64
    content: ${ca_cert_b64}
  - path: /opt/flp/ca.key
    permissions: '0600'
    encoding: b64
    content: ${ca_key_b64}
  - path: /opt/flp/flp-pod-up.sh
    permissions: '0755'
    encoding: b64
    content: ${pod_up_b64}
  - path: /etc/systemd/system/flp.service
    permissions: '0644'
    content: |
      [Unit]
      Description=F5 License Proxy (podman pod) — first-boot bring-up
      After=network-online.target
      Wants=network-online.target
      ConditionPathExists=!/opt/flp/.provisioned
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/opt/flp/flp-pod-up.sh
      [Install]
      WantedBy=multi-user.target
  - path: /opt/flp/flp-health.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # GENTLE self-heal. Two hard rules so it can never loop or interrupt
      # startup: (1) it only ever acts once the proxy has served at least once
      # (the /opt/flp/.served marker) — the initial bring-up (postgres init →
      # Vault unseal → proxy DB retries, ~3-5 min) is left completely alone;
      # (2) it only issues a single `systemctl restart pod-flp.service` — NEVER a
      # destructive re-stage — so a slow restart can't cascade into a rebuild loop.
      if curl -sk --max-time 8 https://localhost:8443/ -o /dev/null 2>/dev/null; then
        touch /opt/flp/.served
        exit 0
      fi
      # Down but has never served → still coming up; do nothing.
      [ -f /opt/flp/.served ] || exit 0
      # Served before and now down → one gentle restart of the systemd-managed pod.
      systemctl restart pod-flp.service 2>/dev/null || true
      exit 0
  - path: /etc/systemd/system/flp-health.service
    permissions: '0644'
    content: |
      [Unit]
      Description=F5 License Proxy health self-heal
      After=network-online.target
      Wants=network-online.target
      [Service]
      Type=oneshot
      ExecStart=/opt/flp/flp-health.sh
  - path: /etc/systemd/system/flp-health.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Periodic F5 License Proxy health check
      [Timer]
      OnBootSec=300s
      OnUnitActiveSec=120s
      [Install]
      WantedBy=timers.target

runcmd:
  # podman-restart.service is a RHEL/Fedora unit — it is NOT shipped on Ubuntu, so
  # do not rely on it. flp.service brings the pod up on first boot; flp-pod-up.sh
  # then generates systemd pod units (reboot survival) and flp-health.timer is the
  # catch-all self-heal.
  - [ systemctl, enable, --now, flp.service ]
  - [ systemctl, enable, --now, flp-health.timer ]

final_message: "FLP VSI provisioned (podman pod on 8443)."
