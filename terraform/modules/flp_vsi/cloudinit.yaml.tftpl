#cloud-config
# F5 License Proxy on a stock Ubuntu VSI (Case B: podman pod, no Kubernetes).
# Rendered by the flp_vsi terraform module. The CA is generated by terraform and
# injected here; the box generates the mTLS leaves from it and brings up the pod.
package_update: true
packages: [podman, openssl, jq]

write_files:
  - path: /opt/flp/answer.env
    permissions: '0600'
    content: |
      JWT_TOKEN=${jwt_token}
      EXTERNAL_IP=${external_ip}
      REG=${reg}
      TAG=${tag}
      VAULT_TAG=${vault_tag}
      F5_CERT_URL=${f5_cert_url}
      F5_ENTITLEMENT_URL=${f5_entitlement_url}
      F5_INITIAL_CONFIG_URL=${f5_initial_config_url}
      MODE_OF_OPERATION=${mode_of_operation}
      IS_PROXY_ENABLED=${proxy_enabled}
      PROXY_HOST=${proxy_host}
      PROXY_PORT=${proxy_port}
      PROXY_PROTOCOL=${proxy_protocol}
  - path: /opt/flp/cne_pull_64.json
    permissions: '0600'
    content: |
      ${far_sa_b64}
  - path: /opt/flp/prod_jwks.txt
    permissions: '0644'
    encoding: b64
    content: ${prod_jwks_b64}
  - path: /opt/flp/ca.crt
    permissions: '0644'
    encoding: b64
    content: ${ca_cert_b64}
  - path: /opt/flp/ca.key
    permissions: '0600'
    encoding: b64
    content: ${ca_key_b64}
  - path: /opt/flp/flp-pod-up.sh
    permissions: '0755'
    encoding: b64
    content: ${pod_up_b64}
  - path: /etc/systemd/system/flp.service
    permissions: '0644'
    content: |
      [Unit]
      Description=F5 License Proxy (podman pod)
      After=network-online.target
      Wants=network-online.target
      ConditionPathExists=!/opt/flp/.provisioned
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/opt/flp/flp-pod-up.sh
      [Install]
      WantedBy=multi-user.target

runcmd:
  - [ systemctl, enable, --now, podman-restart.service ]
  - [ systemctl, enable, --now, flp.service ]

final_message: "FLP VSI provisioned (podman pod on 8443)."
