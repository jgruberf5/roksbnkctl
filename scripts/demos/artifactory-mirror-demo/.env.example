# artifactory-mirror-demo — copy to .env and fill in.
#
# The demo mirrors FAR into a self-hosted Artifactory and stops there. It builds
# no cluster and installs no BNK, so there is very little to configure.

# ---- the Artifactory the demo pushes into --------------------------------
# The public DNS name. It must already resolve to the VSI's floating IP, and
# Caddy must already hold a certificate for it — deploy-artifactory-vsi.sh waits
# for exactly that before it exits.
ART_DOMAIN=artifactory.example.com

# The LOCAL Docker repository created in the Artifactory UI. Remote and virtual
# repositories will not do: a remote repo is a read-through cache and cannot be
# pushed to at all.
ART_REPO=docker-local                     # created by the VSI's config.import.yml; JCR cannot name repos

# An Artifactory user with Deploy + Read on that repository, and an ACCESS TOKEN
# for it (not the account password). A token is scoped and independently
# revocable, which matters more here than usual because this value is handed to
# a container.
ART_USER=admin                           # JCR has no user management (Pro-only)
ART_TOKEN=                               # paste the Artifactory access token here

# ---- what to mirror -------------------------------------------------------
BNK_VERSION=2.3.0-3.2598.3-0.0.170

# ---- where the FAR pull credential lives ----------------------------------
# COS bucket names are GLOBALLY unique, so every account's is suffixed and there
# is no usable default — the built-in "bnk-artifacts" belongs to someone else.
# A wrong value fails with AccessDenied, not NotFound, which reads like a
# credentials problem. `ibmcloud cos buckets` lists yours.
COS_INSTANCE=bnk-supply-chain
COS_BUCKET=                              # e.g. bnk-artifacts-0b5a00334eaf  (REQUIRED)
COS_REGION=us-south

# ---- IBM Cloud ------------------------------------------------------------
# Only needed to resolve the FAR pull credential out of COS. No IBM Cloud
# resource is created or modified by this demo.
IBMCLOUD_API_KEY=                       # IBM Cloud API key (COS read for the FAR credential)
REGION=us-east
RESOURCE_GROUP=default                   # case-sensitive; `ibmcloud resource groups` lists yours

# ---- phase 8: the same mirror as a container ------------------------------
# Needs kubectl + argo pointed at a cluster running Argo Workflows. If there
# isn't one, phase 8 prints the workflow and explains itself instead of running.
RUNNER_IMAGE=ghcr.io/jgruberf5/roksbnkctl-tools-runner:v1.55.1
ARGO_NS=bnk-ci

# ---- only for deploy-artifactory-vsi.sh, not the demo itself --------------
# ARTIFACTORY_IMAGE defaults to the free JFrog Container Registry edition, which
# supports Docker and Helm repositories. Point it at artifactory-pro if you hold
# a licence — nothing downstream changes, because roksbnkctl only ever speaks the
# OCI registry API. Artifactory OSS cannot be used at all: Docker repository
# support is a licensed feature and OSS has no Docker repository type.
# ARTIFACTORY_IMAGE=releases-docker.jfrog.io/jfrog/artifactory-jcr:latest
# ART_PROFILE=bx2-4x16
# ART_VPC_CIDR=10.246.0.0/18
