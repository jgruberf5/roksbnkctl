# Copy to .env and fill in. The demo sources ./.env automatically for
# IBMCLOUD_API_KEY; record.sh sources the whole file into the recorded shell.

# ── Required ──────────────────────────────────────────────────────────────────
IBMCLOUD_API_KEY=                       # IBM Cloud API key (VPC + Kubernetes-Service + Transit-Gateway)
# BNK Forge is OPTIONAL. All three set = phase 3 runs; none set = phase 3 is skipped
# and the rest of the demo runs normally; some-but-not-all is a mistake and stops the
# demo. The BNK_FORGE_URL / BNK_FORGE_USER / BNK_FORGE_PASSWORD names work too.
FORGE_URL=                              # BNK Forge server URL (phase 3 registers with it)
FORGE_USER=                             # Forge username. Default: empty. All three FORGE_* or none — partial dies
FORGE_PASS=                             # Forge password. Default: empty

# ── The cluster this demo BUILDS and DESTROYS (defaults shown) ────────────────
REGION=ca-tor                           # IBM Cloud region everything is created in. Default: ca-tor
RESOURCE_GROUP=default                  # IBM Cloud resource group. Default: default
CLUSTER_NAME=bnk-demo                    # also the workspace name + resource prefix
OCP_VERSION=4.20                        # OpenShift version for the cluster the demo CREATES. Default: 4.20
WORKERS_PER_ZONE=1                       # ROKS spans 3 AZs -> 1/zone = 3 workers

# ── BNK (defaults shown) ─────────────────────────────────────────────────────
BNK_VERSION=2.3.0-3.2598.3-0.0.170       # the FAR manifest version installed in phase 4
BNK_VERSION_REBUILD=                     # set to a DIFFERENT version to show a version swap in phase 6
FAR_REPO_URL=repo.f5.com                # F5 Artifact Repository for charts + images. Default: repo.f5.com

# ── Optional ─────────────────────────────────────────────────────────────────
FORGE_PROJECT=                           # Forge project name, if yours requires one
FORGE_INSECURE=true                      # skip TLS verify (self-signed Forge cert)
TEST_HOSTS=https://www.example.com       # probe targets for phase 5, space-separated

# ── roksbnkctl + pacing ──────────────────────────────────────────────────────
ROKSBNKCTL_BIN=roksbnkctl                # binary on PATH (or an absolute path to a build)
AUTO_ADVANCE=1                           # 1 = hands-off; 0 = wait for ENTER between phases
PHASE_DELAY=6                            # seconds between phases when hands-off
DRY_RUN=0                                # 1 = print the commands without running them
