# artifactory-adopt-ci-demo — the customer shape: adopt everything, install BNK.
#
# Copy to .env in this directory. Nothing here is created by the demo except BNK.

# ── IBM Cloud ────────────────────────────────────────────────────────────────
IBMCLOUD_API_KEY=                       # IBM Cloud API key (Kubernetes-Service + Transit-Gateway)
REGION=us-east
RESOURCE_GROUP=default
PREFIX=bnkadopt

# ── What the customer already has ────────────────────────────────────────────
# The ROKS cluster is REGISTERED, not built. The transit gateway is attached by
# name and never created — creating one silently burns a connection against a
# quota that is usually shared.
EXISTING_CLUSTER=                       # name of the ROKS cluster to adopt
EXISTING_TGW=                           # transit gateway, by name or id — attached, never created

# ── Their Artifactory ────────────────────────────────────────────────────────
# ART_TOKEN is required. Without it the chart pull authenticates as the literal
# username "unused" and Artifactory answers 401 Bad Credentials — and it does so
# part-way through the install, not at the start, unless roksbnkctl catches it
# first (it now does).
ART_DOMAIN=                             # e.g. artifactory.example.com
ART_REPO=docker-local
ART_USER=                               # Artifactory user the token belongs to
ART_TOKEN=                              # access token or password — required
# Only if Artifactory serves a private/self-signed certificate.
ART_CA_FILE=                            # PEM, only if Artifactory is self-signed

# ── F5 entitlement ───────────────────────────────────────────────────────────
BNK_VERSION=2.4.0-EA
FAR_AUTH_FILE=                          # the F5 service-account .tgz
SUBSCRIPTION_JWT_FILE=                  # the F5 subscription JWT

# ── Runner ───────────────────────────────────────────────────────────────────
RUNNER_TAG=v1.55.1
CI_WORKSPACE=bnk-adopt
CI_WORK=$HOME/bnk-adopt-state
