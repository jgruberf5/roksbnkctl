#cloud-config
# =============================================================================
# ArgoCD controller VSI — single-node k3s + ArgoCD + a local git source.
#
# This VSI is the GitOps controller for the disconnected-cluster CI demo. It sits
# in the services VPC (the only egress), so k3s, ArgoCD and the roksbnkctl runner
# image all pull from public registries normally. Only the ROKS *cluster* it
# targets (disco-demo) is air-gapped; ArgoCD reaches it over the TGW.
#
# Rendered by envsubst from the demo before provisioning. Substituted vars:
#   ${ARGOCD_VERSION}   — pinned ArgoCD install manifest tag (e.g. v2.13.2)
#   ${K3S_CHANNEL}      — k3s install channel (e.g. stable)
# Everything with $(...) or a bare $VAR that is NOT one of the above is preserved
# for the shell on the VSI (single-quoted heredocs below guard the runtime bits).
# =============================================================================
write_files:
  # A tiny systemd unit that serves the demo's GitOps tree over the git protocol,
  # bound to the node so ArgoCD's in-cluster repo-server can clone git://<node-ip>/.
  - path: /etc/systemd/system/git-daemon.service
    permissions: '0644'
    content: |
      [Unit]
      Description=git daemon for the GitOps repo
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/bin/git daemon --reuseaddr --verbose --export-all \
        --base-path=/srv/git --enable=receive-pack /srv/git
      Restart=always
      [Install]
      WantedBy=multi-user.target

  # Wait-for-argocd helper the demo polls over SSH before it drives the CLI.
  - path: /usr/local/bin/wait-argocd
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -e
      export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
      for i in $(seq 1 120); do
        kubectl -n argocd get deploy argocd-server >/dev/null 2>&1 && \
        kubectl -n argocd rollout status deploy/argocd-server --timeout=10s >/dev/null 2>&1 && \
        kubectl -n argocd rollout status deploy/argocd-repo-server --timeout=10s >/dev/null 2>&1 && {
          echo "argocd ready"; exit 0; }
        sleep 5
      done
      echo "argocd did not become ready" >&2; exit 1

runcommands: []
runcmd:
  - [ bash, -c, "export DEBIAN_FRONTEND=noninteractive; apt-get update -y && apt-get install -y git git-daemon-run curl jq" ]
  # --- single-node k3s ------------------------------------------------------
  - [ bash, -c, "curl -sfL https://get.k3s.io | INSTALL_K3S_CHANNEL=${K3S_CHANNEL} sh -" ]
  - [ bash, -c, "until kubectl get nodes >/dev/null 2>&1; do sleep 3; done" ]
  # --- ArgoCD (pinned manifest) ---------------------------------------------
  - [ bash, -c, "export KUBECONFIG=/etc/rancher/k3s/k3s.yaml; kubectl create namespace argocd" ]
  - [ bash, -c, "export KUBECONFIG=/etc/rancher/k3s/k3s.yaml; kubectl apply -n argocd -f https://raw.githubusercontent.com/argoproj/argo-cd/${ARGOCD_VERSION}/manifests/install.yaml" ]
  # --- expose the ArgoCD WEB UI over the VSI's floating IP -------------------
  # Serve the console on plain HTTP (server.insecure) at NodePort 30080, so the demo can
  # open http://<argocd-vsi-fip>:30080/ (admin / `argocd admin initial-password`) and watch
  # the app go Synced/Healthy — the same "reachable web UI" pattern as Harbor and the FLP.
  - [ bash, -c, "export KUBECONFIG=/etc/rancher/k3s/k3s.yaml; kubectl -n argocd patch configmap argocd-cmd-params-cm --type merge -p '{\"data\":{\"server.insecure\":\"true\"}}'" ]
  - [ bash, -c, "export KUBECONFIG=/etc/rancher/k3s/k3s.yaml; kubectl -n argocd patch svc argocd-server --type merge -p '{\"spec\":{\"type\":\"NodePort\",\"ports\":[{\"name\":\"http\",\"port\":80,\"targetPort\":8080,\"nodePort\":30080},{\"name\":\"https\",\"port\":443,\"targetPort\":8080,\"nodePort\":30443}]}}'" ]
  - [ bash, -c, "export KUBECONFIG=/etc/rancher/k3s/k3s.yaml; kubectl -n argocd rollout restart deploy/argocd-server" ]
  # --- argocd CLI -----------------------------------------------------------
  - [ bash, -c, "curl -sSL -o /usr/local/bin/argocd https://github.com/argoproj/argo-cd/releases/download/${ARGOCD_VERSION}/argocd-linux-amd64 && chmod +x /usr/local/bin/argocd" ]
  # --- local git source: a bare repo the demo pushes the gitops/ tree into ---
  - [ bash, -c, "mkdir -p /srv/git && git init --bare /srv/git/disconnected-bnk.git && chown -R nobody:nogroup /srv/git" ]
  - [ bash, -c, "systemctl daemon-reload && systemctl enable --now git-daemon.service" ]
  # kubeconfig readable by the ubuntu user, so the demo's SSH commands need no sudo
  - [ bash, -c, "mkdir -p /home/ubuntu/.kube && cp /etc/rancher/k3s/k3s.yaml /home/ubuntu/.kube/config && chown -R ubuntu:ubuntu /home/ubuntu/.kube && echo 'export KUBECONFIG=/home/ubuntu/.kube/config' >> /home/ubuntu/.bashrc" ]
  - [ bash, -c, "/usr/local/bin/wait-argocd || true" ]
  - [ bash, -c, "touch /var/lib/cloud/argocd-vsi-ready" ]
