# Copy to .env and fill in. The demo sources ./.env automatically; record.sh
# sources the whole file into the recorded shell.
#
# This CI demo REUSES the disconnected-cluster CLI demo's infrastructure — its
# services VPC, Harbor VSI, FLP VSI and the existing air-gapped ROKS cluster
# (disco-demo). Run the CLI demo (or otherwise stand those up) first, and run
# `roksbnkctl -w bnk bnk down --auto` on the cluster so it starts empty.

# ── Required: IBM Cloud + the reused services VPC ────────────────────────────
IBMCLOUD_API_KEY=                       # IBM Cloud API key (VPC + Kubernetes-Service + Transit-Gateway)
REGION=us-south
RESOURCE_GROUP=default
SERVICES_VPC=                           # the CLI demo's services VPC (id or name)
SERVICES_SUBNET=                        # a subnet id in that VPC (zone REGION-1) for the ArgoCD VSI

# ── Required: the reused Harbor mirror (private IP, over the TGW) ─────────────
HARBOR_PRIVATE_IP=                      # e.g. 10.241.0.4 — Harbor by PRIVATE IP
HARBOR_CA_B64=                          # base64 of Harbor's CA (so the k3s VSI trusts Harbor to pull the runner)
HARBOR_ADMIN_PASSWORD=                  # Harbor admin password (→ ROKSBNKCTL_GENERIC_PASSWORD in the Job)

# ── Required: the reused standalone FLP (from: roksbnkctl -w flp flp output) ──
FLP_EXTERNAL_URL=                       # the FLP CWC endpoint the cluster licenses against
FLP_ROOT_CA_B64=                        # base64 of the FLP root CA (bnk.flp.external.root_ca_b64)

# ── Orchestration COS holding the FAR pull key + subscription JWT ────────────
# The runner has no local FAR files — it resolves f5-far-auth-key.tgz + subscription.jwt
# from this COS bucket. `roksbnkctl cos object list <bucket> --instance bnk-supply-chain`
# to confirm both objects are present. The bucket name carries a per-account suffix.
FAR_COS_BUCKET=                          # e.g. bnk-artifacts-0b5a00334eaf

# ── The existing air-gapped cluster this pipeline installs BNK onto ──────────
CLUSTER_NAME=disco-demo

# ── SSH (the control channel to the Argo Workflows VSI) ─────────────────────
SSH_KEY_FILE=                           # private key for the VPC ssh key below
SSH_KEY_NAME=bnk-airgap-key             # the IBM Cloud VPC ssh key name

# ── The Argo Workflows controller VSI this demo BUILDS (defaults shown) ──────
ARGO_VSI_NAME=bnk-argo
ARGO_VSI_PROFILE=bx2-4x16
ARGO_VSI_IMAGE=ibm-ubuntu-24-04-4-minimal-amd64-6    # stock name varies by region/date; `ibmcloud is images | grep ubuntu-24-04`
ARGO_WF_VERSION=v4.0.8                   # pinned Argo Workflows install manifest + CLI
K3S_CHANNEL=stable

# ── The runner image (the binary under test; MUST be >= v1.33.0) ────────────
RUNNER_TAG=v1.55.0                       # first tag with roksbnkctl native operator + node CA trust
# RUNNER_IMAGE=ghcr.io/jgruberf5/roksbnkctl-tools-runner:v1.55.0   # full override

# ── Pacing ───────────────────────────────────────────────────────────────────
AUTO_ADVANCE=1                           # 1 = hands-off; 0 = wait for ENTER between phases
PHASE_DELAY=6                            # seconds between phases when hands-off
DRY_RUN=0                                # 1 = print the commands without running them
