# Copy to .env and fill in. The demo sources ./.env automatically for
# IBMCLOUD_API_KEY; export the rest (or `set -a; source .env; set +a`).

# ── Required ──────────────────────────────────────────────────────────────────
IBMCLOUD_API_KEY=                       # IBM Cloud API key (VPC + Kubernetes-Service + Transit-Gateway)
EXISTING_CLUSTER=disco-demo             # the PRE-EXISTING, no-BNK ROKS cluster to adopt
TGW_NAME=bnkci-testing                  # the EXISTING global Transit Gateway to join
SSH_KEY_NAME=bnk-airgap-key             # an SSH key registered in IBM Cloud VPC (for the Harbor/FLP VSIs)
SSH_KEY_FILE=$HOME/.ssh/bnk-airgap-key  # its PRIVATE key on this host
FAR_AUTH_LOCAL_FILE=$HOME/f5/f5-far-auth-key.tgz   # F5 FAR pull credential (from F5)
SUBSCRIPTION_JWT_LOCAL_FILE=$HOME/f5/subscription.jwt   # F5 subscription JWT (from F5)

# ── Placement (defaults shown) ───────────────────────────────────────────────
SVC_REGION=us-east                      # region A: the services VPC (Harbor + FLP) — the only egress
SVC_ZONE=us-east-1
BNK_REGION=us-south                     # region B: where EXISTING_CLUSTER lives
RESOURCE_GROUP=default
SVC_PREFIX=bnk-svc                       # name prefix for the services VPC + Harbor

# ── Harbor (defaults shown) ──────────────────────────────────────────────────
HARBOR_VSI_PROFILE=bx2-4x16
HARBOR_ADMIN_PASSWORD=Harbor12345!
HARBOR_VERSION=v2.11.1
MANIFEST_VERSION=2.3.0-3.2598.3-0.0.170  # the FAR manifest (FLO/CIS) version

# ── roksbnkctl + pacing ──────────────────────────────────────────────────────
ROKSBNKCTL_BIN=roksbnkctl                # binary on PATH (or an absolute path to a build)
AUTO_ADVANCE=1                           # 1 = hands-off; 0 = wait for ENTER between phases
PHASE_DELAY=6                            # seconds between phases when hands-off
DRY_RUN=0                                # 1 = print the commands without running them
