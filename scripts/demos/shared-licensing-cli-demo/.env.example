# Copy to .env and fill in. The demo sources ./.env automatically for
# IBMCLOUD_API_KEY; record.sh sources the whole file into the recorded shell.

# ── Required ──────────────────────────────────────────────────────────────────
IBMCLOUD_API_KEY=                       # IBM Cloud API key
SERVICES_CLUSTER=                       # the RUNNING cluster that will host the FLP
APP_CLUSTER=                            # the RUNNING cluster that will get BNK
# EVERY zone prefix of the app cluster's VPC, comma-separated. One per zone — omit
# one and a pod scheduled there is silently dropped at the security group:
#   ibmcloud is vpc-address-prefixes <vpc> --output json | jq -r '[.[].cidr]|join(",")'
APP_CLUSTER_CIDR=10.242.0.0/18,10.242.64.0/18,10.242.128.0/18
REGISTRY_DOMAIN=                        # the private registry host, e.g. 1.2.3.4.sslip.io
REGISTRY_ADMIN_PASSWORD=                # its admin password (deploy-far-registry.sh prints both)

# ── Placement + versions (defaults shown) ────────────────────────────────────
REGION=ca-tor
RESOURCE_GROUP=default
BNK_VERSION=2.3.0-3.2598.3-0.0.170
FAR_REPO_URL=repo.f5.com
REGISTRY_PROJECT=bnk-mirror              # project / repo prefix in the registry

# ── Workspaces (defaults shown) ──────────────────────────────────────────────
SVC_WS=services                          # workspace for the FLP cluster
APP_WS=app                               # workspace for the BNK cluster
FLP_NAMESPACE=f5-license-proxy

# ── roksbnkctl + pacing ──────────────────────────────────────────────────────
ROKSBNKCTL_BIN=roksbnkctl                # binary on PATH (or an absolute path to a build)
AUTO_ADVANCE=1                           # 1 = hands-off; 0 = wait for ENTER between phases
PHASE_DELAY=6                            # seconds between phases when hands-off
DRY_RUN=0                                # 1 = print the commands without running them
