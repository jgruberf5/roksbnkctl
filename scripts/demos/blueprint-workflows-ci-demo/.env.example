# Copy to .env and fill in. The demo sources ./.env automatically; record.sh sources
# the whole file into the recorded shell.
#
# EVERY SETTING BELOW BECOMES AN ENVIRONMENT VARIABLE IN THE WORKFLOW PODS. The demo
# renders the non-secret ones into the `bnk-env` ConfigMap and the four credentials
# into the `bnk-secrets` Secret; each workflow attaches both with envFrom. There is no
# config.yaml anywhere — `init --non-interactive --override-from-env` builds the whole
# workspace from this environment, which is the only shape available to a BNK Forge
# container module or an argv-only CI runner.
#
# Not every workflow needs every value. The "used by" column names the workflows that
# read each group; leave the rest empty.

# ══ Always required ═══════════════════════════════════════════════════════════
# used by: all
IBMCLOUD_API_KEY=                     # → bnk-secrets. VPC + Kubernetes-Service + Transit-Gateway
ROKSBNKCTL_REGION=us-south
ROKSBNKCTL_RESOURCE_GROUP=default
ROKSBNKCTL_PREFIX=bnk-ci              # names every resource this demo creates

# ══ The FAR supply chain (where the BNK artifacts + credentials come from) ═════
# used by: far-mirror, flp-vsi, new-cluster*, existing-*
# roksbnkctl resolves the FAR pull key and the subscription JWT from COS itself —
# neither is ever a file on the runner. Confirm both objects exist with:
#   roksbnkctl cos object list "$ROKSBNKCTL_COS_BUCKET" --instance "$ROKSBNKCTL_COS_INSTANCE"
ROKSBNKCTL_MANIFEST_VERSION=2.3.0-3.2598.3-0.0.170
ROKSBNKCTL_COS_INSTANCE=bnk-supply-chain   # optional — roksbnkctl defaults this
ROKSBNKCTL_COS_BUCKET=                # ** REQUIRED, no default ** e.g. bnk-artifacts-0b5a00334eaf.
                                      # Account-suffixed, so roksbnkctl cannot guess it. A blank here
                                      # failed a blueprint run 40 minutes in — bnk up cannot reach the
                                      # entitlement without it. The demo now refuses to submit without it.
ROKSBNKCTL_COS_REGION=us-south
ROKSBNKCTL_FAR_AUTH_FILE=f5-far-auth-key.tgz
ROKSBNKCTL_SUBSCRIPTION_JWT_FILE=subscription.jwt

# ══ The private registry (the mirror) ═════════════════════════════════════════
# used by: far-mirror, new-cluster-disconnected, existing-disconnected
# The registry itself is a PREREQUISITE — see the README. wf-far-mirror fills it.
ROKSBNKCTL_REGISTRY_TARGET=generic    # generic | icr  — WHICH registry the mirror IS.
                                      # REQUIRED for the disconnected workflows. `registry adopt`
                                      # has no --target flag: it reads registry.target from the
                                      # workspace, i.e. from THIS variable. Leave it unset and
                                      # adopt records IBM Container Registry, `bnk up` renders
                                      # us.icr.io/<prefix>/... and every pull fails with
                                      # "unauthorized: Authorization required" on a cluster that
                                      # cannot reach ICR anyway.
                                      # Note wf-far-mirror passes `--target generic` as a FLAG,
                                      # which fills the mirror correctly but does NOT write the
                                      # config the later adopt reads — so the flag alone silently
                                      # leaves the two disagreeing.
ROKSBNKCTL_GENERIC_HOST=              # Harbor by PRIVATE IP over the TGW, e.g. 10.241.0.4
ROKSBNKCTL_GENERIC_REPO_PREFIX=bnk-mirror
ROKSBNKCTL_GENERIC_USERNAME=admin
ROKSBNKCTL_GENERIC_PASSWORD=          # → bnk-secrets
# The mirror's CA, taken from the file that GENERATED it — not learned from the wire.
# roksbnkctl refuses to adopt a self-signed CA it merely discovered; supply it here, or
# pin it with the SHA-256 below. On the Harbor VSI:
#   sudo base64 -w0 /opt/harbor/certs/harbor.crt
#   sudo openssl x509 -in /opt/harbor/certs/harbor.crt -noout -fingerprint -sha256
ROKSBNKCTL_GENERIC_CA_B64=
ROKSBNKCTL_GENERIC_CA_SHA256=

# ══ Building a NEW cluster ════════════════════════════════════════════════════
# used by: new-cluster, new-cluster-disconnected
# public_gateway is NOT set here — each workflow pins it (true = connected,
# false = disconnected), because it is the one variable that distinguishes them.
ROKSBNKCTL_OPENSHIFT_VERSION=4.20
ROKSBNKCTL_WORKERS_PER_ZONE=1         # ROKS spans 3 AZs → 1/zone = 3 workers

# ══ Adopting an EXISTING cluster ══════════════════════════════════════════════
# used by: existing-cluster, existing-disconnected
ROKSBNKCTL_CLUSTER_NAME=              # the running cluster to adopt
ROKSBNKCTL_TRANSIT_GATEWAY_NAME=      # the TGW it is already attached to.
                                      # ** ALSO REQUIRED by new-cluster-disconnected **: that cluster
                                      # must JOIN the gateway the mirror and FLP sit on, or it is
                                      # isolated from the only registry it can install from. The
                                      # CONNECTED new-cluster workflow blanks this and makes its own.
# ── bring-your-own cluster network (roksbnkctl #61; forge #8) ───────────────
# Adopt an existing VPC by id, and optionally place the cluster in subnets that
# already exist — one per zone, IN ZONE ORDER, comma-separated. Each subnet's
# zone is read from the subnet itself, so a reordered list places the cluster
# differently rather than failing.
#
# existing_subnet_ids requires the VPC id: a subnet cannot be adopted
# independently of its VPC.
ROKSBNKCTL_CLUSTER_VPC_ID=
ROKSBNKCTL_EXISTING_SUBNET_IDS=

ROKSBNKCTL_CLUSTER_VPC_CIDR=10.245.0.0/16   # address block for a NEWLY CREATED cluster VPC.
                                      # Matters most for new-cluster-disconnected, which creates a VPC AND
                                      # joins a shared gateway. IBM's default "auto" prefixes are IDENTICAL
                                      # for every VPC in a region (10.241.0.0/18, .64.0/18, .128.0/18), so a
                                      # second cluster on that gateway overlaps the first. The gateway does
                                      # not report it — it silently blackholes one VPC, which surfaces as
                                      # intermittent image-pull timeouts from the mirror. Give each cluster
                                      # its own /16. Blank keeps "auto" (fine for a single cluster).
                                      # Split three ways, so /18 is the smallest usable block.
REGISTRY_COS_NAME=                    # registry COS instance; blank → probed by prefix

# ══ The standalone F5 License Proxy VSI ═══════════════════════════════════════
# used by: flp-vsi
# ── the FLP's OWN VPC (roksbnkctl #60; forge #7) ─────────────────────────────
# EITHER adopt a VPC with ROKSBNKCTL_FLP_VSI_VPC below, OR have the proxy build
# its own with these three. They are mutually exclusive — roksbnkctl refuses both.
#
# Creating is what lets the proxy be the FIRST thing deployed in an estate,
# rather than needing something else to have made a VPC already.
ROKSBNKCTL_FLP_VSI_CREATE_VPC=
ROKSBNKCTL_FLP_VSI_VPC_NAME=
# Must not overlap anything the consuming clusters can already route to — a
# transit gateway silently blackholes one of two overlapping VPCs.
ROKSBNKCTL_FLP_VSI_SUBNET_CIDR=

ROKSBNKCTL_FLP_VSI_VPC=               # services VPC id — mode vsi + a non-empty vpc is
ROKSBNKCTL_FLP_VSI_ZONE=us-south-1    #   the PAIR that selects the cluster-less path
ROKSBNKCTL_FLP_VSI_PROFILE=bx2-4x16
ROKSBNKCTL_FLP_VSI_SSH_KEY=           # an IBM Cloud VPC SSH key name
ROKSBNKCTL_FLP_VSI_BOOT_SIZE_GB=100
ROKSBNKCTL_FLP_VSI_REACH=private
ROKSBNKCTL_FLP_VSI_FLOATING_IP=true   # operator address for `flp status` + the :80 UI
ROKSBNKCTL_FLP_VSI_MANAGEMENT_ALLOWED_CIDRS=
ROKSBNKCTL_FLP_VSI_LICENSING_ALLOWED_CIDRS=
# ── settings added in v1.43.0 / v1.44.0 ─────────────────────────────────────
# bnk-env is built from the keys declared in THIS file, so a variable missing
# here never reaches a workflow however it is exported. Every entry below is a
# roksbnkctl setting that had no route into a blueprint until now.

# How the worker nodes are attached. Blank = single-nic, which is every cluster
# built so far. multi-nic needs BNK 2.4+; CREATE-time only and enforced.
ROKSBNKCTL_CLUSTER_NETWORK_MODE=

# The IBM Cloud Trusted Profile the CNE controller assumes to manage its own
# VPC. Blank derives the account FLO actually creates — leave it blank unless
# you can also make FLO name that account differently.
ROKSBNKCTL_TRUSTED_PROFILE_SA=
ROKSBNKCTL_TRUSTED_PROFILE_ROLES=

# TMM self-IP masks. INDEPENDENT of the VLAN CIDRs and never derived from them:
# a mask that deliberately disagrees with its subnet, plus static routes, is how
# a specific traffic pattern is forced. The per-VLAN pair overrides the shared
# value; blank inherits.
ROKSBNKCTL_VLAN_PREFIXLEN=
ROKSBNKCTL_VLAN_PREFIXLEN_EXTERNAL=
ROKSBNKCTL_VLAN_PREFIXLEN_INTERNAL=

# The BIG-IP DNS / GTM the GSLB datacenter registers WITH. Without the URL the
# datacenter name is a label pointing at nothing. The PASSWORD is credential-
# grade and is routed to the Secret, not the ConfigMap — see SECRET_KEYS.
ROKSBNKCTL_GTM_URL=
ROKSBNKCTL_GTM_USERNAME=
ROKSBNKCTL_GTM_PASSWORD=

# ── FLO namespaces (roksbnkctl #66) ─────────────────────────────────────────
# Default f5-bnk and f5-utils. Set BOTH to the same value to install into ONE
# namespace instead of two — verified working against BNK 2.3. Fewer RBAC
# surfaces, one NetworkPolicy target, one thing to grant a team.
#
# These are an allowlist entry as much as a setting: bnk-env is built from the
# keys declared in THIS file, so a variable missing here never reaches a
# workflow no matter what you export.
ROKSBNKCTL_FLO_NAMESPACE=
ROKSBNKCTL_FLO_UTILS_NAMESPACE=

# ── CNEInstance sizing ──────────────────────────────────────────────────────
# Deployment size for the CNEInstance (Tiny / Small / Medium / …). Blank uses the
# terraform default. The legal set is a property of the BNK manifest rather than
# of this tool, so a bad value is rejected by the operator on the cluster rather
# than here — deliberately, since hardcoding a list would go stale the first time
# F5 adds a size.
ROKSBNKCTL_CNEINSTANCE_SIZE=

# ── Gateway API bundle (BNK 2.4 mTLS only) ──────────────────────────────────
# true installs the Gateway API 1.5.0 standard bundle BNK 2.4 needs for mTLS.
# Doing so requires deleting the OpenShift ingress-operator's Gateway API
# ValidatingAdmissionPolicy and its binding, which the platform recreates — the
# race roksbnkctl's admission sweep exists to win.
#
# Blank/false is right for a base install: 2.4's crd-installer logs a graceful
# skip and leaves the cluster on the bundle OpenShift ships. Ignored on 2.3,
# where the sweep always runs because the crd-installer IS blocked without it.
ROKSBNKCTL_GATEWAY_API_MTLS=

# ── BNK 2.4 conformance with F5's reference CNEInstance ──────────────────────
# All 2.4-only. Left empty, terraform applies F5's reference value, so an empty
# value here is "use the reference" rather than "unset".
#
# TMM placement is what REPLACED the node-labeler on 2.4: the labeler was
# removed as unnecessary and this is the mechanism that took over. The topology
# keys are the IBM ROKS node labels, surfaced rather than hard-coded.
ROKSBNKCTL_TMM_REPLICAS=
ROKSBNKCTL_WATCH_NAMESPACES=
ROKSBNKCTL_TMM_ANTI_AFFINITY=
ROKSBNKCTL_TMM_ANTI_AFFINITY_TOPOLOGY_KEY=
ROKSBNKCTL_TMM_ZONE_SPREAD=
ROKSBNKCTL_TMM_ZONE_TOPOLOGY_KEY=
ROKSBNKCTL_TMM_ZONE_MAX_SKEW=
ROKSBNKCTL_TMM_ZONE_WHEN_UNSATISFIABLE=
ROKSBNKCTL_TMM_POD_LABEL=
ROKSBNKCTL_TMM_ROLLING_UPDATE=
ROKSBNKCTL_EXTERNAL_BIGIP=
ROKSBNKCTL_EXTERNAL_BIGIP_LOGIN_SECRET=
ROKSBNKCTL_CLUSTER_IDENTIFIER=
ROKSBNKCTL_GATEWAY_API_VERSION=
ROKSBNKCTL_DEMO_MODE=
ROKSBNKCTL_WHOLE_CLUSTER=

# Adopt what the cluster already has, rather than creating it. An adopted
# customer cluster very often already runs cert-manager; without this, bnk up
# fails with "namespaces cert-manager already exists".
ROKSBNKCTL_CERT_MANAGER_CREATE=
ROKSBNKCTL_REGISTRY_COS_CREATE=
ROKSBNKCTL_CLUSTER_JUMPHOSTS_CREATE=

# Exact worker profile, e.g. cx3d.8x20. Empty auto-selects, which only ever
# considers the bx2 family — F5's reference cluster runs cx3d.8x20, which the
# auto-select cannot produce at any minimum.
ROKSBNKCTL_WORKER_FLAVOR=

# Allocate hugepages on the worker pool. OFF by default: enabling it sets a
# bootloader kernel argument, so the Machine Config Operator DRAINS AND REBOOTS
# every matching worker. deploymentSize Tiny needs none; Small wants 4Gi.
ROKSBNKCTL_HUGEPAGES=
ROKSBNKCTL_HUGEPAGES_SIZE=
ROKSBNKCTL_HUGEPAGES_COUNT=

# F5BigTcpSetting passthrough: ROKSBNKCTL_BNK_TCP_<field>=<value>, field names
# verbatim and case-sensitive. Unset writes no CR.
# ROKSBNKCTL_BNK_TCP_idleTimeout=300

# ── Gateway-phase identity ──────────────────────────────────────────────────
# GatewayClass is CLUSTER-scoped, so two BNK installs sharing a cluster cannot
# share the name. Blank → "gateway-class", which is right for one install per
# cluster and wrong for a matrix that stands two up side by side.
ROKSBNKCTL_GATEWAY_CLASS_NAME=
# The string the CNE controller matches ITSELF against. LEAVE THIS BLANK: blank
# derives "f5.com/<flo_namespace>-f5-cne-controller", which is what a controller
# this deployment installed calls itself, and it follows a changed
# ROKSBNKCTL_FLO_NAMESPACE automatically. Set it only to aim the GatewayClass at
# a controller deployed by something else. A wrong value fails SILENTLY — the
# apply succeeds, the GatewayClass is never Accepted, and no traffic flows.
ROKSBNKCTL_GATEWAY_CONTROLLER_NAME=

# ── Gateway route examples ──────────────────────────────────────────────────
# Extra route kinds to create WORKING examples of, alongside the HTTPRoute the
# gateway phase always creates. Comma-separated. Blank leaves an existing
# deployment byte-identical.
#
# On BNK 2.3 the only valid values are GRPCRoute and L4Route, and that is not
# arbitrary: 2.3 pins Gateway API 1.4.1 STANDARD, which contains no TCPRoute,
# TLSRoute or UDPRoute at all. BNK provides L4Route
# (gateway.k8s.f5net.com/v1) for TCP instead. Anything else is refused at plan
# time rather than creating an object no controller will ever claim.
#
# Setting L4Route also adds a TCP listener to the Gateway, because an L4Route
# cannot attach to an HTTP listener.
ROKSBNKCTL_GATEWAY_ROUTE_EXAMPLES=
# Port for that TCP listener. Blank → 8080.
ROKSBNKCTL_GATEWAY_L4_LISTENER_PORT=

# Prefixes the FLP VSI's IBM Cloud resource names (instance, subnet, SG,
# floating IP, boot volume). BLANK KEEPS THE LEGACY UNPREFIXED NAMES — set it
# and terraform REPLACES a running proxy, because renaming a resource replaces
# it. Two reasons to set it on a new deployment: an account can otherwise hold
# only ONE standalone FLP (they all collide on the name `flp-vsi`), and
# `roksbnkctl cleanup` sweeps by `<prefix>-*`, so unprefixed proxy resources are
# invisible to it and survive a failed `flp down`.
ROKSBNKCTL_FLP_VSI_NAME_PREFIX=

ROKSBNKCTL_FLP_NAMESPACE=f5-license-proxy
# The status UI image, served from the mirror so the VSI pulls nothing public:
ROKSBNKCTL_FLP_VSI_STATUS_IMAGE=
ROKSBNKCTL_FLP_VSI_STATUS_REGISTRY_HOST=
ROKSBNKCTL_FLP_VSI_STATUS_REGISTRY_CA_B64=

# ══ Security-group source CIDRs (optional) ════════════════════════════════════
# used by: new-cluster* (the cluster VPC), and any blueprint that builds jumphosts.
# Comma-separated. Each is left unset by default, which keeps the terraform module's
# own default — and those defaults differ per plane, deliberately:
#
#   jumphost SSH (:22)        open, because you connect from wherever you are (key-only)
#   client VPC default SG     RFC-1918, because in-fabric test traffic arrives over the TGW
#   cluster :80               open, because that is the ingress/ALB path
#   cluster VPC default SG    open (historical) — narrow this one on a shared account
#
# On a shared IBM Cloud account, set at least the first to your own public /32.
ROKSBNKCTL_TESTING_JUMPHOST_ALLOWED_CIDRS=
ROKSBNKCTL_TESTING_CLIENT_VPC_INBOUND_CIDRS=
ROKSBNKCTL_CLUSTER_HTTP_ALLOWED_CIDRS=
ROKSBNKCTL_CLUSTER_VPC_DEFAULT_SG_INBOUND_CIDRS=

# ══ The pre-install reachability gate (optional) ══════════════════════════════
# used by: new-cluster-disconnected, existing-disconnected
# `bnk up` probes the mirror (and the FLP) from EVERY node before anything pulls.
# Both timers default sensibly; set them only when this environment needs different
# ones. There is no config.yaml on the CI path, so these env vars are the only surface.
ROKSBNKCTL_REACHABILITY_RETRY_SECONDS=   # blank → 180. How long ONE target may keep failing
                                      # before the verdict is believed. A Transit Gateway
                                      # attachment is ASYNCHRONOUS — IBM programs the routes
                                      # some time after the connection reports `attached` — so
                                      # a cluster built and installed in one run can probe a
                                      # path that is correct but not yet live. A probe 73s
                                      # after attach has failed on a path that was healthy
                                      # minutes later. RAISE it for new-cluster-disconnected,
                                      # which creates the VPC and joins the gateway in the same
                                      # run. Set 0 for one-shot (a gateway that has been up for
                                      # days never races). A success ends the retry
                                      # immediately, so a healthy path costs nothing.
ROKSBNKCTL_REACHABILITY_TIMEOUT_SECONDS= # blank → 480. How long to wait for EVERY node to
                                      # report. Clamped to stay above the retry budget, so
                                      # raising only the retry cannot produce a timeout that
                                      # looks like the network but is really this file.

# ══ Licensing through the proxy ═══════════════════════════════════════════════
# used by: new-cluster-disconnected, existing-disconnected
# LEAVE THESE EMPTY if you ran wf-flp-vsi.yaml — its last step writes the `flp-handoff`
# Secret and the disconnected workflows envFrom it, so the values never pass through a
# human. Set them only when the FLP was built elsewhere.
# The CA is ALREADY base64: pass it VERBATIM. Re-encoding hands the CWC a corrupt CA.
ROKSBNKCTL_FLP_EXTERNAL_URL=
ROKSBNKCTL_FLP_ROOT_CA_B64=

# ══ The BNK dataplane (F5SPKVlan addressing, per zone) ════════════════════════
# used by: new-cluster*, existing-*
# Required by `bnk up`. One set per zone the cluster spans.
ROKSBNKCTL_ZONE1_EXT_VLAN_CIDR=
ROKSBNKCTL_ZONE1_INT_VLAN_CIDR=
ROKSBNKCTL_ZONE1_INT_SNAT_CIDR=
ROKSBNKCTL_ZONE1_INT_VIP_CIDR=
ROKSBNKCTL_ZONE1_EXTERNAL_SELFIP=
ROKSBNKCTL_ZONE1_INTERNAL_SELFIP=
ROKSBNKCTL_ZONE2_EXT_VLAN_CIDR=
ROKSBNKCTL_ZONE2_INT_VLAN_CIDR=
ROKSBNKCTL_ZONE2_INT_SNAT_CIDR=
ROKSBNKCTL_ZONE2_INT_VIP_CIDR=
ROKSBNKCTL_ZONE2_EXTERNAL_SELFIP=
ROKSBNKCTL_ZONE2_INTERNAL_SELFIP=
ROKSBNKCTL_ZONE3_EXT_VLAN_CIDR=
ROKSBNKCTL_ZONE3_INT_VLAN_CIDR=
ROKSBNKCTL_ZONE3_INT_SNAT_CIDR=
ROKSBNKCTL_ZONE3_INT_VIP_CIDR=
ROKSBNKCTL_ZONE3_EXTERNAL_SELFIP=
ROKSBNKCTL_ZONE3_INTERNAL_SELFIP=

# ══ BIG-IP Next Central Manager (optional) ════════════════════════════════════
ROKSBNKCTL_BIGIP_URL=
ROKSBNKCTL_BIGIP_USERNAME=
ROKSBNKCTL_BIGIP_PASSWORD=            # → bnk-secrets

# ══ BNK Forge registration ════════════════════════════════════════════════════
# used by: new-cluster*, existing-* (submit with -p bnkforge=false to skip)
# roksbnkctl reads these three by these EXACT names (internal/cli/bnkforge.go) —
# BNKFORGE_URL / BNKFORGE_USERNAME would be silently ignored and `bnkforge register`
# would fail with "no BNK Forge URL".
BNK_FORGE_URL=
BNK_FORGE_USER=
BNK_FORGE_PASSWORD=                   # → bnk-secrets
# These two are the DEMO's own names: the workflow passes them as explicit --project /
# --insecure flags, so they never need to match a roksbnkctl env var.
BNKFORGE_PROJECT=
BNKFORGE_INSECURE=true                # Forge usually has a self-signed cert
# --insecure sends the Forge session token over a connection that is encrypted but
# NOT authenticated, and every request says so. Pin the lab CA instead and the
# warning goes away: base64 the PEM into ROKSBNKCTL_BNKFORGE_CA_B64 and drop
# BNKFORGE_INSECURE.  base64 -w0 forge-ca.pem
ROKSBNKCTL_BNKFORGE_CA_B64=

# ══ The cwc Multi-Attach guard ════════════════════════════════════════════════
# used by: existing-* only — the cwc guard runs as a SIDECAR of bnk up there, because
# the deadlock is what makes bnk up fail. Submit with -p cwc-guard=false to skip.
CWC_NAMESPACE=f5-utils
CWC_DEPLOYMENT=f5-spk-cwc
CWC_SELECTOR=app=f5-spk-cwc

# ══ The Argo host + runner image ══════════════════════════════════════════════
# Keep this at the CURRENT release. The demo script defaults to the current
# release, but this file OVERRIDES it (the script reads ${RUNNER_TAG:-...}), so a
# stale pin here silently exercises an old runner however new your binary is.
# Minimums, for reference: ≥ v1.36.0 `registry adopt`, ≥ v1.37.0 `bnkforge
# unregister`, ≥ v1.42.0 retries the reachability gate.
RUNNER_TAG=v1.53.1
# RUNNER_IMAGE=ghcr.io/jgruberf5/roksbnkctl-tools-runner:v1.53.1   # full override
ARGO_NAMESPACE=bnk-ci
KUBECONFIG=                           # kubeconfig for the k3s/ROKS cluster Argo runs on

# ══ Pacing (recording) ════════════════════════════════════════════════════════
AUTO_ADVANCE=1
PHASE_DELAY=6
DRY_RUN=0
