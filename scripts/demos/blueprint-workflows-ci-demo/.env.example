# Copy to .env and fill in. The demo sources ./.env automatically; record.sh sources
# the whole file into the recorded shell.
#
# EVERY SETTING BELOW BECOMES AN ENVIRONMENT VARIABLE IN THE WORKFLOW PODS. The demo
# renders the non-secret ones into the `bnk-env` ConfigMap and the four credentials
# into the `bnk-secrets` Secret; each workflow attaches both with envFrom. There is no
# config.yaml anywhere — `init --non-interactive --override-from-env` builds the whole
# workspace from this environment, which is the only shape available to a BNK Forge
# container module or an argv-only CI runner.
#
# Not every workflow needs every value. The "used by" column names the workflows that
# read each group; leave the rest empty.

# ══ Always required ═══════════════════════════════════════════════════════════
# used by: all
IBMCLOUD_API_KEY=                     # → bnk-secrets. VPC + Kubernetes-Service + Transit-Gateway
ROKSBNKCTL_REGION=us-south
ROKSBNKCTL_RESOURCE_GROUP=default
ROKSBNKCTL_PREFIX=bnk-ci              # names every resource this demo creates

# ══ The FAR supply chain (where the BNK artifacts + credentials come from) ═════
# used by: far-mirror, flp-vsi, new-cluster*, existing-*
# roksbnkctl resolves the FAR pull key and the subscription JWT from COS itself —
# neither is ever a file on the runner. Confirm both objects exist with:
#   roksbnkctl cos object list "$ROKSBNKCTL_COS_BUCKET" --instance "$ROKSBNKCTL_COS_INSTANCE"
ROKSBNKCTL_MANIFEST_VERSION=2.3.0-3.2598.3-0.0.170
ROKSBNKCTL_COS_INSTANCE=bnk-supply-chain   # optional — roksbnkctl defaults this
ROKSBNKCTL_COS_BUCKET=                # ** REQUIRED, no default ** e.g. bnk-artifacts-0b5a00334eaf.
                                      # Account-suffixed, so roksbnkctl cannot guess it. A blank here
                                      # failed a blueprint run 40 minutes in — bnk up cannot reach the
                                      # entitlement without it. The demo now refuses to submit without it.
ROKSBNKCTL_COS_REGION=us-south
ROKSBNKCTL_FAR_AUTH_FILE=f5-far-auth-key.tgz
ROKSBNKCTL_SUBSCRIPTION_JWT_FILE=subscription.jwt

# ══ The private registry (the mirror) ═════════════════════════════════════════
# used by: far-mirror, new-cluster-disconnected, existing-disconnected
# The registry itself is a PREREQUISITE — see the README. wf-far-mirror fills it.
ROKSBNKCTL_REGISTRY_TARGET=generic    # generic | icr  — WHICH registry the mirror IS.
                                      # REQUIRED for the disconnected workflows. `registry adopt`
                                      # has no --target flag: it reads registry.target from the
                                      # workspace, i.e. from THIS variable. Leave it unset and
                                      # adopt records IBM Container Registry, `bnk up` renders
                                      # us.icr.io/<prefix>/... and every pull fails with
                                      # "unauthorized: Authorization required" on a cluster that
                                      # cannot reach ICR anyway.
                                      # Note wf-far-mirror passes `--target generic` as a FLAG,
                                      # which fills the mirror correctly but does NOT write the
                                      # config the later adopt reads — so the flag alone silently
                                      # leaves the two disagreeing.
ROKSBNKCTL_GENERIC_HOST=              # Harbor by PRIVATE IP over the TGW, e.g. 10.241.0.4
ROKSBNKCTL_GENERIC_REPO_PREFIX=bnk-mirror
ROKSBNKCTL_GENERIC_USERNAME=admin
ROKSBNKCTL_GENERIC_PASSWORD=          # → bnk-secrets
# The mirror's CA, taken from the file that GENERATED it — not learned from the wire.
# roksbnkctl refuses to adopt a self-signed CA it merely discovered; supply it here, or
# pin it with the SHA-256 below. On the Harbor VSI:
#   sudo base64 -w0 /opt/harbor/certs/harbor.crt
#   sudo openssl x509 -in /opt/harbor/certs/harbor.crt -noout -fingerprint -sha256
ROKSBNKCTL_GENERIC_CA_B64=
ROKSBNKCTL_GENERIC_CA_SHA256=

# ══ Building a NEW cluster ════════════════════════════════════════════════════
# used by: new-cluster, new-cluster-disconnected
# public_gateway is NOT set here — each workflow pins it (true = connected,
# false = disconnected), because it is the one variable that distinguishes them.
ROKSBNKCTL_OPENSHIFT_VERSION=4.20
ROKSBNKCTL_WORKERS_PER_ZONE=1         # ROKS spans 3 AZs → 1/zone = 3 workers

# ══ Adopting an EXISTING cluster ══════════════════════════════════════════════
# used by: existing-cluster, existing-disconnected
ROKSBNKCTL_CLUSTER_NAME=              # the running cluster to adopt
ROKSBNKCTL_TRANSIT_GATEWAY_NAME=      # the TGW it is already attached to.
                                      # ** ALSO REQUIRED by new-cluster-disconnected **: that cluster
                                      # must JOIN the gateway the mirror and FLP sit on, or it is
                                      # isolated from the only registry it can install from. The
                                      # CONNECTED new-cluster workflow blanks this and makes its own.
ROKSBNKCTL_CLUSTER_VPC_CIDR=          # address block for a NEWLY CREATED cluster VPC, e.g. 10.242.0.0/16.
                                      # Matters most for new-cluster-disconnected, which creates a VPC AND
                                      # joins a shared gateway. IBM's default "auto" prefixes are IDENTICAL
                                      # for every VPC in a region (10.241.0.0/18, .64.0/18, .128.0/18), so a
                                      # second cluster on that gateway overlaps the first. The gateway does
                                      # not report it — it silently blackholes one VPC, which surfaces as
                                      # intermittent image-pull timeouts from the mirror. Give each cluster
                                      # its own /16. Blank keeps "auto" (fine for a single cluster).
                                      # Split three ways, so /18 is the smallest usable block.
REGISTRY_COS_NAME=                    # registry COS instance; blank → probed by prefix

# ══ The standalone F5 License Proxy VSI ═══════════════════════════════════════
# used by: flp-vsi
ROKSBNKCTL_FLP_VSI_VPC=               # services VPC id — mode vsi + a non-empty vpc is
ROKSBNKCTL_FLP_VSI_ZONE=us-south-1    #   the PAIR that selects the cluster-less path
ROKSBNKCTL_FLP_VSI_PROFILE=bx2-4x16
ROKSBNKCTL_FLP_VSI_SSH_KEY=           # an IBM Cloud VPC SSH key name
ROKSBNKCTL_FLP_VSI_BOOT_SIZE_GB=100
ROKSBNKCTL_FLP_VSI_REACH=private
ROKSBNKCTL_FLP_VSI_FLOATING_IP=true   # operator address for `flp status` + the :80 UI
ROKSBNKCTL_FLP_VSI_MANAGEMENT_ALLOWED_CIDRS=
ROKSBNKCTL_FLP_VSI_LICENSING_ALLOWED_CIDRS=
ROKSBNKCTL_FLP_NAMESPACE=f5-license-proxy
# The status UI image, served from the mirror so the VSI pulls nothing public:
ROKSBNKCTL_FLP_VSI_STATUS_IMAGE=
ROKSBNKCTL_FLP_VSI_STATUS_REGISTRY_HOST=
ROKSBNKCTL_FLP_VSI_STATUS_REGISTRY_CA_B64=

# ══ Licensing through the proxy ═══════════════════════════════════════════════
# used by: new-cluster-disconnected, existing-disconnected
# LEAVE THESE EMPTY if you ran wf-flp-vsi.yaml — its last step writes the `flp-handoff`
# Secret and the disconnected workflows envFrom it, so the values never pass through a
# human. Set them only when the FLP was built elsewhere.
# The CA is ALREADY base64: pass it VERBATIM. Re-encoding hands the CWC a corrupt CA.
ROKSBNKCTL_FLP_EXTERNAL_URL=
ROKSBNKCTL_FLP_ROOT_CA_B64=

# ══ The BNK dataplane (F5SPKVlan addressing, per zone) ════════════════════════
# used by: new-cluster*, existing-*
# Required by `bnk up`. One set per zone the cluster spans.
ROKSBNKCTL_ZONE1_EXT_VLAN_CIDR=
ROKSBNKCTL_ZONE1_INT_VLAN_CIDR=
ROKSBNKCTL_ZONE1_INT_SNAT_CIDR=
ROKSBNKCTL_ZONE1_INT_VIP_CIDR=
ROKSBNKCTL_ZONE1_EXTERNAL_SELFIP=
ROKSBNKCTL_ZONE1_INTERNAL_SELFIP=
ROKSBNKCTL_ZONE2_EXT_VLAN_CIDR=
ROKSBNKCTL_ZONE2_INT_VLAN_CIDR=
ROKSBNKCTL_ZONE2_INT_SNAT_CIDR=
ROKSBNKCTL_ZONE2_INT_VIP_CIDR=
ROKSBNKCTL_ZONE2_EXTERNAL_SELFIP=
ROKSBNKCTL_ZONE2_INTERNAL_SELFIP=
ROKSBNKCTL_ZONE3_EXT_VLAN_CIDR=
ROKSBNKCTL_ZONE3_INT_VLAN_CIDR=
ROKSBNKCTL_ZONE3_INT_SNAT_CIDR=
ROKSBNKCTL_ZONE3_INT_VIP_CIDR=
ROKSBNKCTL_ZONE3_EXTERNAL_SELFIP=
ROKSBNKCTL_ZONE3_INTERNAL_SELFIP=

# ══ BIG-IP Next Central Manager (optional) ════════════════════════════════════
ROKSBNKCTL_BIGIP_URL=
ROKSBNKCTL_BIGIP_USERNAME=
ROKSBNKCTL_BIGIP_PASSWORD=            # → bnk-secrets

# ══ BNK Forge registration ════════════════════════════════════════════════════
# used by: new-cluster*, existing-* (submit with -p bnkforge=false to skip)
# roksbnkctl reads these three by these EXACT names (internal/cli/bnkforge.go) —
# BNKFORGE_URL / BNKFORGE_USERNAME would be silently ignored and `bnkforge register`
# would fail with "no BNK Forge URL".
BNK_FORGE_URL=
BNK_FORGE_USER=
BNK_FORGE_PASSWORD=                   # → bnk-secrets
# These two are the DEMO's own names: the workflow passes them as explicit --project /
# --insecure flags, so they never need to match a roksbnkctl env var.
BNKFORGE_PROJECT=
BNKFORGE_INSECURE=true                # Forge usually has a self-signed cert

# ══ The cwc Multi-Attach guard ════════════════════════════════════════════════
# used by: existing-* only — the cwc guard runs as a SIDECAR of bnk up there, because
# the deadlock is what makes bnk up fail. Submit with -p cwc-guard=false to skip.
CWC_NAMESPACE=f5-utils
CWC_DEPLOYMENT=f5-spk-cwc
CWC_SELECTOR=app=f5-spk-cwc

# ══ The Argo host + runner image ══════════════════════════════════════════════
RUNNER_TAG=v1.38.0                    # ≥ v1.36.0 for `registry adopt`; ≥ v1.37.0 for `bnkforge unregister`
# RUNNER_IMAGE=ghcr.io/jgruberf5/roksbnkctl-tools-runner:v1.38.0   # full override
ARGO_NAMESPACE=bnk-ci
KUBECONFIG=                           # kubeconfig for the k3s/ROKS cluster Argo runs on

# ══ Pacing (recording) ════════════════════════════════════════════════════════
AUTO_ADVANCE=1
PHASE_DELAY=6
DRY_RUN=0
