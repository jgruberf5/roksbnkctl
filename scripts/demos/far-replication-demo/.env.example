# Copy to .env and fill in. The demo sources ./.env automatically for
# IBMCLOUD_API_KEY; record.sh sources the whole file into the recorded shell.

# ── Required ──────────────────────────────────────────────────────────────────
IBMCLOUD_API_KEY=                       # IBM Cloud API key (COS read for the FAR credential)
REGISTRY_DOMAIN=                        # the private registry host, e.g. 1.2.3.4.sslip.io
REGISTRY_ADMIN_PASSWORD=                # its admin password (deploy-far-registry.sh prints both)

# ── Source + target (defaults shown) ─────────────────────────────────────────
FAR_REPO_URL=repo.f5.com                 # the SOURCE registry to mirror FROM
BNK_VERSION=2.3.0-3.2598.3-0.0.170       # the FAR manifest whose BOM is mirrored
REGISTRY_PROJECT=bnk-mirror              # project / repo prefix in the target registry

# ── Workspace placement (defaults shown) ─────────────────────────────────────
REGION=ca-tor
RESOURCE_GROUP=default
FAR_WORKSPACE=bnk-mirror                 # the roksbnkctl workspace (no cluster is created)

# ── The FAR credential in COS (defaults match roksbnkctl's own constants) ────
# Not a secret you supply: roksbnkctl downloads this tarball from COS and extracts
# the service account itself. Override only if your COS layout differs.
COS_INSTANCE=bnk-orchestration
COS_BUCKET=bnk-schematics-resources
FAR_AUTH_FILE=f5-far-auth-key.tgz

# ── roksbnkctl + pacing ──────────────────────────────────────────────────────
ROKSBNKCTL_BIN=roksbnkctl                # binary on PATH (or an absolute path to a build)
AUTO_ADVANCE=1                           # 1 = hands-off; 0 = wait for ENTER between phases
PHASE_DELAY=6                            # seconds between phases when hands-off
DRY_RUN=0                                # 1 = print the commands without running them
