# Generated by roksbnkctl. Do not edit by hand — run `roksbnkctl init` to update.
# IBMCLOUD_API_KEY is NOT written here; it's passed via TF_VAR env var.

ibmcloud_cluster_region = "us-south"
create_roks_cluster = false
roks_cluster_vpc_name = "gold-cluster-vpc"
cluster_network_mode = "single-nic"
create_roks_registry_cos_instance = true
roks_cos_instance_name = "gold-registry-cos"
create_roks_transit_gateway = true
roks_transit_gateway_name = "gold-tgw"
install_cert_manager = true
deploy_bnk = true
testing_create_tgw_jumphost = false
testing_create_client_vpc = false
testing_create_cluster_jumphosts = false
flo_namespace = "f5-bnk-x"
flo_utils_namespace = "f5-utils-x"
flo_trusted_profile_sa_name = "sa"
flo_trusted_profile_roles = ["Viewer", "Editor"]
cneinstance_gtm_url = "https://gtm"
cneinstance_gtm_username = "u"
cneinstance_gtm_password = "pw"
cneinstance_gslb_datacenter_name = "dc1"
cert_manager_namespace = "cm"
cert_manager_version = "v1.2.3"
ibmcloud_cos_instance_name = "cos-inst"
ibmcloud_resources_cos_bucket = "bnk-artifacts"
ibmcloud_cos_bucket_region = "us-south"
cneinstance_deployment_size = "small"
far_repo_url = "repo.f5.com"
far_chart_repo_url = "h/bnk-mirror"
far_image_repo_url = "h/bnk-mirror"
use_registry_mirror = true
f5_bigip_k8s_manifest_version = "v2.3.0"
license_mode = "f5licenseproxy"
flp_namespace = "flp-ns"
flp_chart_version = "v1"
flp_storage_class = "sc"
flp_vsi_name_prefix = "flp"
flp_vsi_profile = "bx2-2x8"
flp_vsi_zone = "z"
flp_vsi_boot_size_gb = 100
flp_vsi_reach = "public"
flp_vsi_management_allowed_cidrs = ["10.0.0.0/8"]
flp_vsi_licensing_allowed_cidrs = ["10.1.0.0/16"]
flp_vsi_ssh_key = "k"
flp_vsi_floating_ip = true
cneinstance_network_zones = [
  {
    ext_vlan_cidr   = "10.0.1.0/24"
    int_vlan_cidr   = "10.0.2.0/24"
    int_snat_cidr   = "10.0.3.0/24"
    int_vip_cidr    = "10.0.4.0/24"
    external_selfip = "10.0.1.5"
    internal_selfip = "10.0.2.5"
  },
]
cneinstance_vlan_prefixlen = 24
bigip_url = "https://1.2.3.4"
bigip_username = "admin"
bigip_password = "pw"
gateway_app_namespace = "apps"
gateway_class_name = "gc"
gateway_controller_name = "cn"
gateway_backend_service = "svc"
gateway_backend_port = 80
gateway_egress_mode = "snat"
gateway_route_examples = ["GRPCRoute", "L4Route"]
gateway_l4_listener_port = 8080
kubeconfig_dir = "/kdir"
scratch_dir = "/sdir"
