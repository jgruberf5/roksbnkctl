# ============================================================================
# roksbnkctl environment overrides.
#
#   roksbnkctl config env > .env                    # this template
#   roksbnkctl config env --from-yaml config.yaml   # the same settings, populated
#   set -a; . ./.env; set +a                        # load it into a shell
#   roksbnkctl -w <ws> init --non-interactive --override-from-env
#
# Every variable here maps to one config.yaml field, shown after the name. A
# workspace can be configured entirely from these, which is what a CI runner
# does -- it has no file to edit.
#
# Values are COMMENTED OUT. Uncomment only what you intend to set: an empty
# assignment is not the same as leaving a setting alone, and unset is what lets
# roksbnkctl apply its default.
# ============================================================================

# ---- bnk ----
#   That account's password, base64-encoded — obfuscation, not encryption.
# ROKSBNKCTL_BIGIP_PASSWORD=          # -> bnk.cis.bigip_password_b64
#   The management address of the classic BIG-IP that the Container Ingress Services controller configures, e.g.
# ROKSBNKCTL_BIGIP_URL=          # -> bnk.cis.bigip_url
#   The account CIS authenticates to that BIG-IP as.
# ROKSBNKCTL_BIGIP_USERNAME=          # -> bnk.cis.bigip_username
#   Namespace cert-manager installs into (rendered as cert_manager_namespace).
# ROKSBNKCTL_CERT_MANAGER_NAMESPACE=          # -> bnk.cert_manager.namespace
#   Version pins the cert-manager Helm chart (rendered as cert_manager_version).
# ROKSBNKCTL_CERT_MANAGER_VERSION=          # -> bnk.cert_manager.version
#   Passed to the external BIG-IP controller.
# ROKSBNKCTL_CLUSTER_IDENTIFIER=          # -> bnk.cluster_identifier
#   The CNEInstance deploymentSize: Tiny, Small, Medium, Large or Max.
# ROKSBNKCTL_CNEINSTANCE_SIZE=          # -> bnk.cneinstance_size
#   DemoMode sets advanced.demoMode.enabled.
# ROKSBNKCTL_DEMO_MODE=          # -> bnk.demo_mode
#   ExternalBigIP enables the external BIG-IP controller.
# ROKSBNKCTL_EXTERNAL_BIGIP=          # -> bnk.external_bigip
#   ExternalBigIPLoginSecret holds the external BIG-IP credentials.
# ROKSBNKCTL_EXTERNAL_BIGIP_LOGIN_SECRET=          # -> bnk.external_bigip_login_secret
#   The FAR auth tarball's filename in the orchestration COS bucket; rendered as the f5_cne_far_auth_file tfvar + used by `registry` to resolve the FAR...
# ROKSBNKCTL_FAR_AUTH_FILE=          # -> bnk.far_auth_file
#   FarAuthLocalFile / SubscriptionJWTLocalFile point at LOCAL files instead of COS objects.
# ROKSBNKCTL_FAR_AUTH_LOCAL_FILE=          # -> bnk.far_auth_local_file
#   The F5 Artifact Repository charts are pulled from.
# ROKSBNKCTL_FAR_REPO_URL=          # -> bnk.far_repo_url
#   FLONamespace / FLOUtilsNamespace override the namespaces the F5 Lifecycle Operator and its utility components install into (rendered as flo_namespa...
# ROKSBNKCTL_FLO_NAMESPACE=          # -> bnk.flo_namespace
#   Where FLO's SHARED utility components install — coremond, the observer, the licence — as opposed to FLONamespace, which holds the BNK instance ...
# ROKSBNKCTL_FLO_UTILS_NAMESPACE=          # -> bnk.flo_utils_namespace
#   ChartVersion pins the f5-license-proxy chart.
# ROKSBNKCTL_FLP_CHART_VERSION=          # -> bnk.flp.chart_version
#   URL of the proxy, e.g.
# ROKSBNKCTL_FLP_EXTERNAL_URL=          # -> bnk.flp.external.url
#   Mode selects HOW the FLP phase deploys the proxy: "" | "helm" → the f5-license-proxy Helm chart into the ROKS cluster (default).
# ROKSBNKCTL_FLP_MODE=          # -> bnk.flp.mode
#   Namespace the FLP is installed into (helm mode).
# ROKSBNKCTL_FLP_NAMESPACE=          # -> bnk.flp.namespace
#   NodePortAccess exposes the proxy OUTSIDE its own cluster, so a BNK install in a DIFFERENT cluster (same VPC, or across a transit gateway) can licen...
# ROKSBNKCTL_FLP_NODE_PORT_ACCESS=          # -> bnk.flp.node_port_access
# ROKSBNKCTL_FLP_NODE_PORT_SOURCE_CIDRS=          # -> bnk.flp.node_port_source_cidrs[0]
#   The proxy's root CA, base64-encoded (as `flp output` emits it).
# ROKSBNKCTL_FLP_ROOT_CA_B64=          # -> bnk.flp.external.root_ca_b64
#   The dynamic StorageClass for the FLP's PVCs (rendered as flp_storage_class).
# ROKSBNKCTL_FLP_STORAGE_CLASS=          # -> bnk.flp.storage_class
# ROKSBNKCTL_FLP_VSI_ALLOWED_CIDRS=          # -> bnk.flp.vsi.allowed_cidrs[0]
#   The boot volume size.
# ROKSBNKCTL_FLP_VSI_BOOT_SIZE_GB=          # -> bnk.flp.vsi.boot_size_gb
#   CreateVPC builds the proxy its OWN VPC, address prefix and public gateway rather than placing it in one that already exists (#60).
# ROKSBNKCTL_FLP_VSI_CREATE_VPC=          # -> bnk.flp.vsi.create_vpc
#   FloatingIP attaches an operator floating IP to the FLP VSI for remote management — running `roksbnkctl flp status` and reaching the :80 web UI + ...
# ROKSBNKCTL_FLP_VSI_FLOATING_IP=          # -> bnk.flp.vsi.floating_ip
#   The forward proxy's address.
# ROKSBNKCTL_FLP_VSI_FORWARD_PROXY_HOST=          # -> bnk.flp.vsi.forward_proxy.host
#   The forward proxy's port.
# ROKSBNKCTL_FLP_VSI_FORWARD_PROXY_PORT=          # -> bnk.flp.vsi.forward_proxy.port
#   http (default) | https
# ROKSBNKCTL_FLP_VSI_FORWARD_PROXY_PROTOCOL=          # -> bnk.flp.vsi.forward_proxy.protocol
# ROKSBNKCTL_FLP_VSI_LICENSING_ALLOWED_CIDRS=          # -> bnk.flp.vsi.licensing_allowed_cidrs[0]
# ROKSBNKCTL_FLP_VSI_MANAGEMENT_ALLOWED_CIDRS=          # -> bnk.flp.vsi.management_allowed_cidrs[0]
#   NamePrefix prefixes the FLP VSI's IBM Cloud resource names — instance, subnet, security group, floating IP, public gateway, boot volume, and the ...
# ROKSBNKCTL_FLP_VSI_NAME_PREFIX=          # -> bnk.flp.vsi.name_prefix
#   The IBM Cloud VSI instance profile.
# ROKSBNKCTL_FLP_VSI_PROFILE=          # -> bnk.flp.vsi.profile
#   The name of an existing IBM Cloud VPC SSH key (RSA) to attach to the FLP VSI, so an operator can SSH in to inspect/recover the licensing appliance ...
# ROKSBNKCTL_FLP_VSI_SSH_KEY=          # -> bnk.flp.vsi.ssh_key
#   StatusImage, when set, runs the flp-status web UI as a container in the FLP pod (mobile-friendly status page + /api/status + live logs on :80, no a...
# ROKSBNKCTL_FLP_VSI_STATUS_IMAGE=          # -> bnk.flp.vsi.status_image
#   That registry's CA, base64-encoded, written to /etc/containers/certs.d/<host>/ca.crt on the VSI.
# ROKSBNKCTL_FLP_VSI_STATUS_REGISTRY_CA_B64=          # -> bnk.flp.vsi.status_registry_ca_b64
#   StatusRegistryHost + StatusRegistryCAB64 make the VSI trust a self-signed mirror so it can pull StatusImage: cloud-init drops the (base64) CA into ...
# ROKSBNKCTL_FLP_VSI_STATUS_REGISTRY_HOST=          # -> bnk.flp.vsi.status_registry_host
#   The address prefix for that VPC.
# ROKSBNKCTL_FLP_VSI_SUBNET_CIDR=          # -> bnk.flp.vsi.subnet_cidr
#   An existing VPC id to deploy the standalone FLP VSI into, WITHOUT any ROKS cluster.
# ROKSBNKCTL_FLP_VSI_VPC=          # -> bnk.flp.vsi.vpc
#   VPCName names the VPC created when CreateVPC is set.
# ROKSBNKCTL_FLP_VSI_VPC_NAME=          # -> bnk.flp.vsi.vpc_name
#   Zone the VSI lands in (e.g.
# ROKSBNKCTL_FLP_VSI_ZONE=          # -> bnk.flp.vsi.zone
#   Where the Gateway API standard-install bundle is FETCHED from when `gateway_api_mtls` is on (#185).
# ROKSBNKCTL_GATEWAY_API_BUNDLE_URL=          # -> bnk.gateway_api_bundle_url
#   GatewayAPIMTLS opts into the Gateway API bundle BNK 2.4 needs for mTLS (#170).
# ROKSBNKCTL_GATEWAY_API_MTLS=          # -> bnk.gateway_api_mtls
#   GATEWAY_API_VERSION for the CNE controller.
# ROKSBNKCTL_GATEWAY_API_VERSION=          # -> bnk.gateway_api_version
#   GSLBDatacenterName sets the optional CNEInstance GSLB datacenter name (rendered as cneinstance_gslb_datacenter_name).
# ROKSBNKCTL_GSLB_DATACENTER_NAME=          # -> bnk.gslb_datacenter_name
#   Enabled allocates hugepages.
# ROKSBNKCTL_HUGEPAGES=          # -> bnk.hugepages.enabled
#   The number of pages PER NODE.
# ROKSBNKCTL_HUGEPAGES_COUNT=          # -> bnk.hugepages.count
#   The machineconfiguration.openshift.io/role the profile applies to.
# ROKSBNKCTL_HUGEPAGES_NODE_ROLE=          # -> bnk.hugepages.node_role
#   ProfileName names the Tuned profile and CR.
# ROKSBNKCTL_HUGEPAGES_PROFILE_NAME=          # -> bnk.hugepages.profile_name
#   The hugepage size, e.g.
# ROKSBNKCTL_HUGEPAGES_SIZE=          # -> bnk.hugepages.size
#   LicenseMode selects the License CR operationMode: "connected" (default when empty), "disconnected", or "f5licenseproxy".
# ROKSBNKCTL_LICENSE_MODE=          # -> bnk.license_mode
#   ManifestVersion pins the BNK release, e.g.
# ROKSBNKCTL_MANIFEST_VERSION=          # -> bnk.manifest_version
#   How long a target may keep failing before the verdict is believed.
# ROKSBNKCTL_REACHABILITY_RETRY_SECONDS=          # -> bnk.preflight.reachability_retry_seconds
#   How long to wait for the probe DaemonSet to report from every node.
# ROKSBNKCTL_REACHABILITY_TIMEOUT_SECONDS=          # -> bnk.preflight.reachability_timeout_seconds
#   The StorageClass the CNEInstance's persistent volumes use, TMM's included.
# ROKSBNKCTL_STORAGE_CLASS_NAME=          # -> bnk.storage_class_name
#   The subscription/license JWT's filename in the orchestration COS bucket; rendered as the f5_cne_subscription_jwt_file tfvar.
# ROKSBNKCTL_SUBSCRIPTION_JWT_FILE=          # -> bnk.subscription_jwt_file
#   The F5 subscription JWT as a LOCAL file, the companion to FarAuthLocalFile above.
# ROKSBNKCTL_SUBSCRIPTION_JWT_LOCAL_FILE=          # -> bnk.subscription_jwt_local_file
#   The F5BigTcpSetting to write.
# ROKSBNKCTL_TCP_SETTINGS_NAME=          # -> bnk.tcp_settings_name
#   TMMAntiAffinity requires f5-tmm pods onto different nodes.
# ROKSBNKCTL_TMM_ANTI_AFFINITY=          # -> bnk.tmm_anti_affinity
#   The node label the anti-affinity rule spreads across — the IBM ROKS per-node label.
# ROKSBNKCTL_TMM_ANTI_AFFINITY_TOPOLOGY_KEY=          # -> bnk.tmm_anti_affinity_topology_key
#   The Kubernetes pod CIDR TMM installs a route toward (advanced.tmm.env TMM_K8S_ROUTES), so TMM can reach backend pods on the internal data path.
# ROKSBNKCTL_TMM_K8S_ROUTES=          # -> bnk.network.tmm_k8s_routes
#   The `app` label value the placement rules select TMM by.
# ROKSBNKCTL_TMM_POD_LABEL=          # -> bnk.tmm_pod_label
#   The number of f5-tmm data-plane replicas.
# ROKSBNKCTL_TMM_REPLICAS=          # -> bnk.tmm_replicas
#   TMMRollingUpdate pins TMM's rolling update to maxSurge 0 / maxUnavailable 1 — the same shape as the cwc Multi-Attach deadlock, where an unconstra...
# ROKSBNKCTL_TMM_ROLLING_UPDATE=          # -> bnk.tmm_rolling_update
#   MaxSkew for the zone topology-spread constraint.
# ROKSBNKCTL_TMM_ZONE_MAX_SKEW=          # -> bnk.tmm_zone_max_skew
#   TMMZoneSpread spreads f5-tmm pods across zones.
# ROKSBNKCTL_TMM_ZONE_SPREAD=          # -> bnk.tmm_zone_spread
#   The IBM ROKS zone label the spread constraint uses.
# ROKSBNKCTL_TMM_ZONE_TOPOLOGY_KEY=          # -> bnk.tmm_zone_topology_key
#   DoNotSchedule or ScheduleAnyway.
# ROKSBNKCTL_TMM_ZONE_WHEN_UNSATISFIABLE=          # -> bnk.tmm_zone_when_unsatisfiable
# ROKSBNKCTL_TRUSTED_PROFILE_ROLES=          # -> bnk.trusted_profile.roles[0]
#   The Kubernetes service account the profile is LINKED to: which account may assume it.
# ROKSBNKCTL_TRUSTED_PROFILE_SA=          # -> bnk.trusted_profile.service_account
#   The self-IP prefix length (spec.prefixlen_v4) TMM applies to its external and internal self-IPs on the F5SPKVlan CRs — the size of the L2 subnet ...
# ROKSBNKCTL_VLAN_PREFIXLEN=          # -> bnk.network.vlan_prefixlen
#   VLANPrefixLenExternal / VLANPrefixLenInternal override VLANPrefixLen for one VLAN.
# ROKSBNKCTL_VLAN_PREFIXLEN_EXTERNAL=          # -> bnk.network.vlan_prefixlen_external
#   The same override for the INTERNAL VLAN.
# ROKSBNKCTL_VLAN_PREFIXLEN_INTERNAL=          # -> bnk.network.vlan_prefixlen_internal
# ROKSBNKCTL_WATCH_NAMESPACES=          # -> bnk.watch_namespaces[0]
#   TCPSettings overrides fields on the data-plane F5BigTcpSetting CR.
# ROKSBNKCTL_WHOLE_CLUSTER=          # -> bnk.whole_cluster
# ROKSBNKCTL_ZONE1_EXTERNAL_SELFIP=          # -> bnk.network.zones[0].external_selfip
# ROKSBNKCTL_ZONE1_EXT_VLAN_CIDR=          # -> bnk.network.zones[0].ext_vlan_cidr
# ROKSBNKCTL_ZONE1_INTERNAL_SELFIP=          # -> bnk.network.zones[0].internal_selfip
# ROKSBNKCTL_ZONE1_INT_SNAT_CIDR=          # -> bnk.network.zones[0].int_snat_cidr
# ROKSBNKCTL_ZONE1_INT_VIP_CIDR=          # -> bnk.network.zones[0].int_vip_cidr
# ROKSBNKCTL_ZONE1_INT_VLAN_CIDR=          # -> bnk.network.zones[0].int_vlan_cidr
# ROKSBNKCTL_ZONE2_EXTERNAL_SELFIP=          # -> bnk.network.zones[1].external_selfip
# ROKSBNKCTL_ZONE2_EXT_VLAN_CIDR=          # -> bnk.network.zones[1].ext_vlan_cidr
# ROKSBNKCTL_ZONE2_INTERNAL_SELFIP=          # -> bnk.network.zones[1].internal_selfip
# ROKSBNKCTL_ZONE2_INT_SNAT_CIDR=          # -> bnk.network.zones[1].int_snat_cidr
# ROKSBNKCTL_ZONE2_INT_VIP_CIDR=          # -> bnk.network.zones[1].int_vip_cidr
# ROKSBNKCTL_ZONE2_INT_VLAN_CIDR=          # -> bnk.network.zones[1].int_vlan_cidr
# ROKSBNKCTL_ZONE3_EXTERNAL_SELFIP=          # -> bnk.network.zones[2].external_selfip
# ROKSBNKCTL_ZONE3_EXT_VLAN_CIDR=          # -> bnk.network.zones[2].ext_vlan_cidr
# ROKSBNKCTL_ZONE3_INTERNAL_SELFIP=          # -> bnk.network.zones[2].internal_selfip
# ROKSBNKCTL_ZONE3_INT_SNAT_CIDR=          # -> bnk.network.zones[2].int_snat_cidr
# ROKSBNKCTL_ZONE3_INT_VIP_CIDR=          # -> bnk.network.zones[2].int_vip_cidr
# ROKSBNKCTL_ZONE3_INT_VLAN_CIDR=          # -> bnk.network.zones[2].int_vlan_cidr

# ---- bnkforge ----
#   CAB64 pins the CA the Forge server's certificate must chain to, PEM, base64-encoded.
# ROKSBNKCTL_BNKFORGE_CA_B64=          # -> bnkforge.ca_b64
#   Insecure skips TLS verification against the Forge server.
# ROKSBNKCTL_BNKFORGE_INSECURE=          # -> bnkforge.insecure
#   That user's password, base64-encoded — obfuscation, NOT encryption, exactly as bnk.cis.bigip_password_b64 and registry.generic_password_b64 are.
# ROKSBNKCTL_BNKFORGE_PASSWORD=          # -> bnkforge.password_b64
#   The target BNK Forge project NAME.
# ROKSBNKCTL_BNKFORGE_PROJECT=          # -> bnkforge.project
#   Register opts the workspace in.
# ROKSBNKCTL_BNKFORGE_REGISTER=          # -> bnkforge.register
#   The BNK Forge server base URL (e.g.
# ROKSBNKCTL_BNKFORGE_URL=          # -> bnkforge.url
#   The BNK Forge login user.
# ROKSBNKCTL_BNKFORGE_USERNAME=          # -> bnkforge.username

# ---- cluster ----
#   Create decides whether this workspace BUILDS the ROKS cluster or adopts one that already exists.
# ROKSBNKCTL_CLUSTER_CREATE=          # -> cluster.create
#   The ROKS cluster's name — the one to create, or the existing one to adopt when Create is false.
# ROKSBNKCTL_CLUSTER_NAME=          # -> cluster.name
#   NetworkMode selects how the cluster's worker nodes are attached: "single-nic" (the default, and today's only behaviour) or "multi-nic".
# ROKSBNKCTL_CLUSTER_NETWORK_MODE=          # -> cluster.network_mode
#   PublicGateway controls whether the cluster subnets attach a public gateway for worker Internet egress.
# ROKSBNKCTL_CLUSTER_PUBLIC_GATEWAY=          # -> cluster.public_gateway
#   The block the cluster VPC's per-zone address prefixes are carved from — "10.241.0.0/16" becomes 10.241.0.0/18, 10.241.64.0/18, 10.241.128.0/18.
# ROKSBNKCTL_CLUSTER_VPC_CIDR=          # -> cluster.vpc_cidr
# ROKSBNKCTL_EXISTING_SUBNET_IDS=          # -> cluster.existing_subnet_ids[0]
#   The memory floor for the same auto-select.
# ROKSBNKCTL_MIN_WORKER_MEMORY_GB=          # -> cluster.min_worker_memory_gb
#   The vCPU floor for the worker-flavor auto-select: the cluster module picks the smallest bx2 profile meeting this and MinWorkerMemoryGB.
# ROKSBNKCTL_MIN_WORKER_VCPU_COUNT=          # -> cluster.min_worker_vcpu_count
#   OpenShiftVersion pins the OpenShift version for a CREATED cluster (e.g.
# ROKSBNKCTL_OPENSHIFT_VERSION=          # -> cluster.openshift_version
#   The worker count PER ZONE, not in total: ROKS spans three availability zones, so 2 here is a six-node cluster.
# ROKSBNKCTL_WORKERS_PER_ZONE=          # -> cluster.workers_per_zone
#   WorkerFlavor names the worker profile EXACTLY, e.g.
# ROKSBNKCTL_WORKER_FLAVOR=          # -> cluster.worker_flavor

# ---- cos ----
#   The bucket the FAR service-account credential is read from, for estates that stage it centrally rather than passing a local file.
# ROKSBNKCTL_COS_BUCKET=          # -> cos.bucket
#   The IBM Cloud Object Storage service instance holding the bucket.
# ROKSBNKCTL_COS_INSTANCE=          # -> cos.instance
#   The bucket's region, which need not match ibmcloud.region.
# ROKSBNKCTL_COS_REGION=          # -> cos.region

# ---- gateway ----
#   The namespace the example application and its Gateway resources are created in.
# ROKSBNKCTL_GATEWAY_APP_NAMESPACE=          # -> gateway.app_namespace
#   The port on that Service.
# ROKSBNKCTL_GATEWAY_BACKEND_PORT=          # -> gateway.backend_port
#   The Kubernetes Service the example HTTPRoute forwards to.
# ROKSBNKCTL_GATEWAY_BACKEND_SERVICE=          # -> gateway.backend_service
#   The GatewayClass name.
# ROKSBNKCTL_GATEWAY_CLASS_NAME=          # -> gateway.class_name
# ROKSBNKCTL_GATEWAY_CLIENT_SUBNET_LOCAL=          # -> gateway.client_subnet_local[0]
# ROKSBNKCTL_GATEWAY_CLIENT_SUBNET_REMOTE=          # -> gateway.client_subnet_remote[0]
#   The GatewayClass controllerName.
# ROKSBNKCTL_GATEWAY_CONTROLLER_NAME=          # -> gateway.controller_name
#   EgressMode selects how return traffic is source-addressed: "snatpool", "automap", or "both".
# ROKSBNKCTL_GATEWAY_EGRESS_MODE=          # -> gateway.egress_mode
#   The port for that TCP listener.
# ROKSBNKCTL_GATEWAY_L4_LISTENER_PORT=          # -> gateway.l4_listener_port
# ROKSBNKCTL_GATEWAY_ROUTE_EXAMPLES=          # -> gateway.route_examples[0]
#   The UDP port for the VXLAN overlay between TMM and the nodes.
# ROKSBNKCTL_GATEWAY_VXLAN_PORT=          # -> gateway.vxlan_port

# ---- ibmcloud ----
#   APIKeyB64 stores the API key base64-encoded inline in the workspace config.
# IBMCLOUD_API_KEY=          # -> ibmcloud.api_key_b64
#   APIKeyB64 stores the API key base64-encoded inline in the workspace config.
# ROKSBNKCTL_API_KEY_B64=          # -> ibmcloud.api_key_b64
#   env | keychain | config | prompt — see secrets.go
# ROKSBNKCTL_API_KEY_SOURCE=          # -> ibmcloud.api_key_source
#   The IBM Cloud region everything in this workspace is created in or adopted from, e.g.
# ROKSBNKCTL_REGION=          # -> ibmcloud.region
#   The IBM Cloud resource group resources are placed in, and the one an adopted cluster is looked up in.
# ROKSBNKCTL_RESOURCE_GROUP=          # -> ibmcloud.resource_group

# ---- prefix ----
#   The workspace's account-scoped resource-name base.
# ROKSBNKCTL_PREFIX=          # -> prefix

# ---- registry ----
#   The mirror's CA chain, PEM, base64-encoded — the AUTHORITATIVE copy, recorded from the file that generated it rather than learned from the network.
# ROKSBNKCTL_GENERIC_CA_B64=          # -> registry.generic_ca_b64
#   GenericCASHA256 pins the mirror's CA by SHA-256 (hex; a "sha256:" prefix and colons are accepted).
# ROKSBNKCTL_GENERIC_CA_SHA256=          # -> registry.generic_ca_sha256
#   The OCI registry host for target=generic (e.g.
# ROKSBNKCTL_GENERIC_HOST=          # -> registry.generic_host
#   That user's password or access token, base64-encoded — obfuscation, not encryption.
# ROKSBNKCTL_GENERIC_PASSWORD=          # -> registry.generic_password_b64
#   The repository path artifacts nest under for target=generic (e.g.
# ROKSBNKCTL_GENERIC_REPO_PREFIX=          # -> registry.generic_repo_prefix
#   GenericUsername / GenericPasswordB64 are the static basic-auth credential for target=generic (an Artifactory user + access token).
# ROKSBNKCTL_GENERIC_USERNAME=          # -> registry.generic_username
#   ICRHost overrides the IBM Container Registry host for target=icr (e.g.
# ROKSBNKCTL_ICR_HOST=          # -> registry.icr_host
#   The ICR namespace artifacts nest under for target=icr.
# ROKSBNKCTL_ICR_NAMESPACE=          # -> registry.icr_namespace
#   IncludeDeps unions the non-F5 dependency artifacts (Jetstack cert-manager chart + images, the bitnami/kubectl node-labeler image) into the BOM.
# ROKSBNKCTL_REGISTRY_INCLUDE_DEPS=          # -> registry.include_deps
#   The mirror project the artifacts land in.
# ROKSBNKCTL_REGISTRY_NAMESPACE=          # -> registry.namespace
#   Target selects the mirror backend: "icr" (IBM Container Registry — the DEFAULT when unset) or "generic" (any OCI-compliant registry — Artifacto...
# ROKSBNKCTL_REGISTRY_TARGET=          # -> registry.target
#   The FAR `_json_key_base64` service-account JSON, base64-encoded, used as the replication SOURCE credential for repo.f5.com.
# ROKSBNKCTL_SOURCE_SERVICE_ACCOUNT_B64=          # -> registry.source_service_account_b64

# ---- resources ----
#   Create decides whether roksbnkctl provisions this resource or adopts one that already exists.
# ROKSBNKCTL_BNK_CREATE=          # -> resources.bnk.create
#   The name or ID of the resource to adopt when Create is false.
# ROKSBNKCTL_BNK_EXISTING=          # -> resources.bnk.existing
#   Create decides whether roksbnkctl provisions this resource or adopts one that already exists.
# ROKSBNKCTL_CERT_MANAGER_CREATE=          # -> resources.cert_manager.create
#   The name or ID of the resource to adopt when Create is false.
# ROKSBNKCTL_CERT_MANAGER_EXISTING=          # -> resources.cert_manager.existing
#   The region the testing client (TGW jumphost + client VPC) is installed in.
# ROKSBNKCTL_CLIENT_REGION=          # -> resources.client_region
#   Create decides whether roksbnkctl provisions this resource or adopts one that already exists.
# ROKSBNKCTL_CLIENT_VPC_CREATE=          # -> resources.client_vpc.create
#   The name or ID of the resource to adopt when Create is false.
# ROKSBNKCTL_CLIENT_VPC_NAME=          # -> resources.client_vpc.existing
# ROKSBNKCTL_CLUSTER_HTTP_ALLOWED_CIDRS=          # -> resources.cluster_http_allowed_cidrs[0]
#   Create decides whether roksbnkctl provisions this resource or adopts one that already exists.
# ROKSBNKCTL_CLUSTER_JUMPHOSTS_CREATE=          # -> resources.cluster_jumphosts.create
#   The name or ID of the resource to adopt when Create is false.
# ROKSBNKCTL_CLUSTER_JUMPHOSTS_EXISTING=          # -> resources.cluster_jumphosts.existing
#   Create decides whether roksbnkctl provisions this resource or adopts one that already exists.
# ROKSBNKCTL_CLUSTER_VPC_CREATE=          # -> resources.cluster_vpc.create
# ROKSBNKCTL_CLUSTER_VPC_DEFAULT_SG_INBOUND_CIDRS=          # -> resources.cluster_vpc_default_sg_inbound_cidrs[0]
#   The name or ID of the resource to adopt when Create is false.
# ROKSBNKCTL_CLUSTER_VPC_ID=          # -> resources.cluster_vpc.existing
# ROKSBNKCTL_COPIED_SSH_KEY_FILES=          # -> resources.copied_ssh_key_files[0]
#   Create decides whether roksbnkctl provisions this resource or adopts one that already exists.
# ROKSBNKCTL_REGISTRY_COS_CREATE=          # -> resources.registry_cos.create
#   The name or ID of the resource to adopt when Create is false.
# ROKSBNKCTL_REGISTRY_COS_EXISTING=          # -> resources.registry_cos.existing
# ROKSBNKCTL_TESTING_CLIENT_VPC_INBOUND_CIDRS=          # -> resources.testing_client_vpc_inbound_cidrs[0]
# ROKSBNKCTL_TESTING_JUMPHOST_ALLOWED_CIDRS=          # -> resources.testing_jumphost_allowed_cidrs[0]
#   Jumphost sizing.
# ROKSBNKCTL_TESTING_JUMPHOST_PROFILE=          # -> resources.testing_jumphost_profile
#   The memory floor for the same auto-select.
# ROKSBNKCTL_TESTING_MIN_MEMORY_GB=          # -> resources.testing_min_memory_gb
#   The vCPU floor for the jumphost auto-select.
# ROKSBNKCTL_TESTING_MIN_VCPU_COUNT=          # -> resources.testing_min_vcpu_count
#   The IBM Cloud VPC SSH key name attached to the testing jumphosts (rendered as testing_ssh_key_name).
# ROKSBNKCTL_TESTING_SSH_KEY_NAME=          # -> resources.testing_ssh_key_name
#   TestingClientVPCName names the testing client VPC when ClientVPC.Create is true (rendered as testing_client_vpc_name).
# ROKSBNKCTL_TESTING_VPC_NAME=          # -> resources.testing_client_vpc_name
#   Create decides whether roksbnkctl provisions this resource or adopts one that already exists.
# ROKSBNKCTL_TGW_JUMPHOST_CREATE=          # -> resources.tgw_jumphost.create
#   The name or ID of the resource to adopt when Create is false.
# ROKSBNKCTL_TGW_JUMPHOST_EXISTING=          # -> resources.tgw_jumphost.existing
#   Create decides whether roksbnkctl provisions this resource or adopts one that already exists.
# ROKSBNKCTL_TRANSIT_GATEWAY_CREATE=          # -> resources.transit_gateway.create
#   The name or ID of the resource to adopt when Create is false.
# ROKSBNKCTL_TRANSIT_GATEWAY_NAME=          # -> resources.transit_gateway.existing
