apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: {{ .ExternalNADName }}
  namespace: {{ .Namespace }}
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "external-network",
      "type": "host-device",
      "device": "{{ .ExternalIFName }}"
    }
---
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: {{ .InternalNADName }}
  namespace: {{ .Namespace }}
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "internal-network",
      "type": "host-device",
      "device": "{{ .InternalIFName }}"
    }
